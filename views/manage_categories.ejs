<!DOCTYPE html>
<html>
<head>
    <script src="/js/admin.js"></script>
    <title>Simeon Admin - Categories</title>
    <style>
        * { box-sizing: border-box; }
        body { 
            background: linear-gradient(135deg, #F8F4F1 0%, #F5EDE3 100%); 
            margin: 0; 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            min-height: 100vh;
            display: flex;
        }
        
        .sidebar {
            width: 280px; 
            background: linear-gradient(180deg, #2D1B14 0%, #1A0F0A 100%);
            height: 100vh; 
            color: white; 
            padding: 30px 25px;
            position: fixed;
            box-shadow: 4px 0 20px rgba(45, 27, 20, 0.3);
            overflow-y: auto;
        }
        
        .logo-section {
            text-align: center; 
            margin-bottom: 35px; 
            padding-bottom: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        
        .logo-img {
            width: 65px; 
            height: 65px; 
            border-radius: 50%; 
            border: 3px solid #C6A664;
            margin-bottom: 12px;
            box-shadow: 0 4px 15px rgba(198, 166, 100, 0.3);
        }
        
        .logo-title {
            color: #C6A664; 
            margin: 0 0 15px 0;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        
        .store-status {
            background: rgba(255,255,255,0.08); 
            padding: 20px; 
            border-radius: 16px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
        }
        
        .status-label {
            font-size: 12px; 
            margin-bottom: 12px; 
            color: rgba(255,255,255,0.6);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .status-btn { 
            border: none; 
            padding: 14px 20px; 
            border-radius: 25px; 
            color: white; 
            font-weight: 600;
            font-size: 14px;
            cursor: pointer; 
            width: 100%; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.3px;
            backdrop-filter: blur(10px);
        }
        
        .status-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }
        
        .btn-open { 
            background: linear-gradient(135deg, #27ae60, #2ecc71); 
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.4);
        }
        
        .btn-closed { 
            background: linear-gradient(135deg, #e74c3c, #c0392b); 
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
        }
        
        .nav-section {
            margin-top: 25px;
        }
        
        .nav-item { 
            color: rgba(255,255,255,0.75); 
            text-decoration: none; 
            padding: 14px 18px; 
            border-radius: 12px; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 15px; 
            font-weight: 500;
            display: block; 
            margin-bottom: 8px;
            position: relative;
            overflow: hidden;
        }
        
        .nav-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 0;
            background: #C6A664;
            transition: height 0.3s ease;
        }
        
        .nav-item:hover::before,
        .nav-item.active::before {
            height: 100%;
        }
        
        .nav-item:hover, 
        .nav-item.active { 
            background: rgba(255,255,255,0.12); 
            color: white; 
            transform: translateX(4px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        
        .nav-divider {
            border: 0; 
            border-top: 1px solid rgba(255,255,255,0.12); 
            margin: 25px 0;
        }
        
        .live-site-link {
            color: #C6A664 !important;
            border: 2px solid rgba(198, 166, 100, 0.3);
            background: rgba(198, 166, 100, 0.1);
            text-align: center;
            font-weight: 600;
            margin-top: 10px;
        }
        
        .live-site-link:hover {
            background: rgba(198, 166, 100, 0.2);
            border-color: rgba(198, 166, 100, 0.6);
            transform: translateX(4px) !important;
        }
        
        .logout-link {
            color: #ff7675 !important;
            font-weight: 600;
        }
        
        .logout-link:hover {
            background: rgba(255, 118, 117, 0.1);
            border-color: rgba(255, 118, 117, 0.3);
        }
        
        .main-content {
            margin-left: 280px; 
            padding: 50px; 
            width: calc(100% - 280px);
            min-height: 100vh;
        }
        
        .page-header {
            color: #2D1B14; 
            margin-bottom: 40px;
            font-size: 36px;
            font-weight: 700;
            letter-spacing: -0.5px;
        }
        
        .card { 
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            padding: 35px;
            border-radius: 24px; 
            box-shadow: 0 20px 60px rgba(45, 27, 20, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.3);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        .card:hover {
            transform: translateY(-2px);
            box-shadow: 0 30px 80px rgba(45, 27, 20, 0.12);
        }
        
        .form-group {
            display: flex; 
            gap: 20px; 
            align-items: center;
            flex-wrap: wrap;
        }
        
        input[type="text"] { 
            padding: 16px 20px; 
            border: 2px solid #E8DCCA; 
            border-radius: 16px; 
            width: 350px; 
            outline: none;
            font-size: 15px;
            transition: all 0.3s ease;
            background: rgba(255, 255, 255, 0.8);
        }
        
        input[type="text"]:focus {
            border-color: #C6A664;
            box-shadow: 0 0 0 4px rgba(198, 166, 100, 0.1);
            background: white;
            transform: translateY(-1px);
        }
        
        .btn-add { 
            background: linear-gradient(135deg, #2D1B14, #3A271C); 
            color: #F0E6D2; 
            border: none; 
            padding: 16px 32px; 
            border-radius: 16px; 
            font-weight: 700;
            cursor: pointer; 
            font-size: 15px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.5px;
            box-shadow: 0 6px 20px rgba(45, 27, 20, 0.3);
        }
        
        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(45, 27, 20, 0.4);
            background: linear-gradient(135deg, #3A271C, #4D3528);
        }
        
        table { 
            width: 100%; 
            border-collapse: separate; 
            border-spacing: 0;
            margin-top: 10px;
        }
        
        th { 
            text-align: left; 
            padding: 20px; 
            background: linear-gradient(135deg, #2D1B14, #3A271C);
            color: white; 
            border-radius: 16px 16px 0 0;
            font-weight: 600;
            font-size: 15px;
            letter-spacing: 0.3px;
        }
        
        td { 
            padding: 20px; 
            border-bottom: 1px solid rgba(232, 220, 202, 0.5);
            transition: background 0.2s ease;
        }
        
        tr:hover td {
            background: rgba(198, 166, 100, 0.05);
        }
        
        .delete-btn {
            color: #e74c3c; 
            text-decoration: none; 
            font-weight: 600;
            padding: 8px 16px;
            border-radius: 8px;
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        
        .delete-btn:hover {
            background: rgba(231, 76, 60, 0.1);
            transform: translateY(-1px);
        }
        
        .empty-state {
            text-align: center; 
            color: #888; 
            padding: 60px 20px;
            font-size: 16px;
        }
        
        @media (max-width: 768px) {
            .sidebar { width: 260px; }
            .main-content { margin-left: 260px; padding: 30px 20px; }
            input[type="text"] { width: 100%; max-width: 300px; }
        }
    </style>
</head>
<body>
   <div class="sidebar">
        <div class="logo-section">
            <img src="/Simeon Cafe.jpg" class="logo-img" alt="Simeon Brewers" onerror="this.src='https://via.placeholder.com/65x65/2D1B14/C6A664?text=S'">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <div class="status-label">STORE STATUS</div>
                <form action="/admin/toggle-status" method="POST">
                    <button type="submit" class="status-btn <%= storeOpen ? 'btn-open' : 'btn-closed' %>">
                        <%= storeOpen ? '● OPEN' : '○ CLOSED' %>
                    </button>
                </form>
            </div>
        </div>
        
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item active">
                <i class="fas fa-list"></i> Active Orders
            </a>
            <a href="/admin/categories" class="nav-item">
                <i class="fas fa-tags"></i> Manage Categories
            </a>
            <a href="/admin/menu" class="nav-item">
                <i class="fas fa-utensils"></i> Manage Menu
            </a>
            <a href="/admin/reports" class="nav-item">
                <i class="fas fa-chart-bar"></i> Daily Reports
            </a>
            
            <hr class="nav-divider">
            
            <a href="/" target="_blank" class="nav-item live-site-link">
                <i class="fas fa-external-link-alt"></i> View Live Site ↗
            </a>
            
            <hr class="nav-divider">
            
            <a href="/logout" class="nav-item logout-link">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <div class="main-content">
        <h2 class="page-header">Menu Categories</h2>
        
        <div class="card" style="margin-bottom: 35px;">
            <form action="/admin/add-category" method="POST" class="form-group">
                <input type="text" name="name" placeholder="Enter new category name..." required>
                <button type="submit" class="btn-add">Add Category</button>
            </form>
        </div>
        
        <div class="card">
            <table>
                <thead>
                    <tr>
                        <th>Category Name</th>
                        <th style="text-align: center;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (categories.length > 0) { %>
                        <% categories.forEach(cat => { %>
                            <tr>
                                <td style="font-weight: 500; color: #2D1B14;"><%= cat.name %></td>
                                <td style="text-align: center;">
                                    <a href="/admin/delete-category/<%= cat.id %>" 
                                       onclick="return confirm('Are you sure you want to delete this category?')" 
                                       class="delete-btn">
                                       Delete
                                    </a>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="2" class="empty-state">
                                No categories found. Create your first category above!
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>