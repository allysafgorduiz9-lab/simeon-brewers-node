<!DOCTYPE html>
<html>
<head>
    <title>Simeon Admin - Categories</title>
    <style>
        .nav-item { color: rgba(255,255,255,0.7); text-decoration: none; padding: 12px; border-radius: 8px; transition: 0.3s; font-size: 14px; display: block; }
        .nav-item:hover, .active { background: rgba(255,255,255,0.1); color: white; }
        .card { background: white; padding: 25px; border-radius: 15px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }
        input { padding: 10px; border: 1px solid #ddd; border-radius: 8px; width: 250px; }
        .btn-add { background: #2D1B14; color: #C6A664; border: none; padding: 10px 20px; border-radius: 8px; font-weight: bold; cursor: pointer; }
        .status-btn { border: none; padding: 10px; border-radius: 20px; color: white; font-weight: bold; cursor: pointer; width: 100%; transition: 0.3s; }
        .btn-open { background-color: #27ae60; }
        .btn-closed { background-color: #e74c3c; }
    </style>
</head>
<body style="background: #F8F4F1; display: flex; margin: 0; font-family: 'Segoe UI', sans-serif;">

    <div style="width: 260px; background: #2D1B14; height: 100vh; color: white; padding: 25px; position: fixed; box-sizing: border-box;">
        <div style="text-align: center; margin-bottom: 20px;">
            <h3 style="color: #C6A664; margin-bottom: 20px;">SIMEON BREWERS</h3>
            <div style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px; margin-bottom: 20px;">
                <p style="font-size: 11px; margin-bottom: 8px; color: #aaa;">STORE STATUS</p>
                <form action="/admin/toggle-status" method="POST">
                    <button type="submit" class="status-btn <%= storeOpen ? 'btn-open' : 'btn-closed' %>">
                        <%= storeOpen ? '● OPEN' : '○ CLOSED' %>
                    </button>
                </form>
            </div>
        </div>
        <nav>
            <a href="/admin/orders" class="nav-item">Active Orders</a>
            <a href="/admin/categories" class="nav-item active">Manage Categories</a>
            <a href="/admin/menu" class="nav-item">Manage Menu</a>
            <a href="/admin/reports" class="nav-item">Daily Reports</a>
            <a href="/" target="_blank" class="nav-item" style="color: #C6A664; border: 1px solid rgba(198, 166, 100, 0.3); margin-top: 15px; text-align: center; font-weight: bold;">View Live Site ↗</a>
            <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.1); margin: 15px 0;">
            <a href="/logout" class="nav-item" style="color: #ff7675;">Logout</a>
        </nav>
    </div>

    <div style="margin-left: 260px; padding: 40px; width: 100%;">
        <h2 style="color: #2D1B14;">Menu Categories</h2>
        <div class="card" style="margin-bottom: 30px;">
            <form action="/admin/add-category" method="POST" style="display: flex; gap: 10px; align-items: center;">
                <input type="text" name="name" placeholder="Enter new category" required>
                <button type="submit" class="btn-add">Add Category</button>
            </form>
        </div>
        <div class="card">
            <table style="width: 100%; border-collapse: collapse;">
                <thead><tr style="text-align: left; border-bottom: 2px solid #eee;"><th style="padding: 10px;">Category Name</th><th style="padding: 10px; text-align: center;">Action</th></tr></thead>
                <tbody>
                    <% if (categories.length > 0) { %>
                        <% categories.forEach(cat => { %>
                            <tr style="border-bottom: 1px solid #eee;"><td style="padding: 15px;"><%= cat.name %></td><td style="padding: 15px; text-align: center;"><a href="/admin/delete-category/<%= cat.id %>" onclick="return confirm('Delete?')" style="color: #e74c3c; text-decoration: none; font-weight: bold;">Delete</a></td></tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>