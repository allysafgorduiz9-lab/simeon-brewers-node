<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Simeon Cafe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0f0f0f;
            --card-dark: #1a1a1a;
            --accent-gold: #C6A664;
            --text-light: #ffffff;
            --text-dim: #b3b3b3;
            --border: rgba(255,255,255,0.1);
            --danger: #e74c3c;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            margin: 0;
            padding: 40px 5%;
        }

        .checkout-layout {
            display: grid;
            grid-template-columns: 1fr 450px;
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }

        @media (max-width: 950px) {
            .checkout-layout { grid-template-columns: 1fr; }
        }

        .card {
            background: var(--card-dark);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
        }

        h2, h3 { font-family: 'Playfair Display', serif; color: var(--accent-gold); margin-top: 0; margin-bottom: 20px; }

        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
            position: relative;
        }

        .cart-item:hover {
            background: rgba(255,255,255,0.02);
        }

        .cart-item-details { flex: 1; }
        .cart-item-qty { color: var(--accent-gold); font-weight: 600; }

        /* Remove Button */
        .remove-btn {
            background: none;
            border: none;
            color: var(--text-dim);
            cursor: pointer;
            font-size: 18px;
            padding: 8px;
            border-radius: 50%;
            transition: all 0.3s;
            margin-left: 15px;
        }

        .remove-btn:hover {
            color: var(--danger);
            background: rgba(231,76,60,0.15);
            transform: scale(1.1);
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            font-size: 22px;
            font-weight: 600;
            color: var(--accent-gold);
        }

        /* Form Fields with X Error */
        .form-group { margin-bottom: 15px; position: relative; }
        label { display: block; font-size: 13px; color: var(--text-dim); margin-bottom: 6px; }

        .field-wrapper {
            position: relative;
            display: block;
        }

        input, textarea, select {
            width: 100%;
            padding: 12px 40px 12px 12px;
            background: #252525;
            border: 1px solid #444;
            border-radius: 10px;
            color: white;
            font-family: inherit;
            outline: none;
            box-sizing: border-box;
        }

        input:focus, select:focus, textarea:focus { border-color: var(--accent-gold); }

        .input-error {
            border-color: var(--danger) !important;
            box-shadow: 0 0 5px rgba(231,76,60,0.3);
        }

        .error-icon {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--danger);
            font-size: 18px;
            display: none;
        }

        .field-wrapper.has-error .error-icon { display: block; }
        .field-wrapper.has-error label { color: var(--danger); }

        .error-text {
            color: var(--danger);
            font-size: 12px;
            margin-top: 5px;
            display: none;
        }

        .field-wrapper.has-error .error-text { display: block; }

        .payment-options { display: flex; gap: 10px; margin: 15px 0; }
        .payment-options div { flex: 1; }
        .payment-radio { display: none; }
        .payment-label {
            border: 1px solid #333;
            padding: 12px;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            display: block;
            font-size: 14px;
            transition: all 0.3s;
        }
        .payment-radio:checked + .payment-label {
            border-color: var(--accent-gold);
            background: rgba(198, 166, 100, 0.1);
            color: var(--accent-gold);
        }

        #gcash-details { display: none; }

        .btn-order {
            background: var(--accent-gold);
            color: black;
            border: none;
            padding: 18px;
            border-radius: 12px;
            width: 100%;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            margin-top: 10px;
            transition: all 0.3s;
        }
        .btn-order:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(198,166,100,0.3); }
        .btn-order:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }

        .back-link { color: var(--text-dim); text-decoration: none; display: inline-block; margin-bottom: 20px; }
        .back-link:hover { color: var(--accent-gold); }

        .receipt-modal {
            position: fixed; top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.95); z-index: 10000; display: none;
            align-items: center; justify-content: center; backdrop-filter: blur(10px);
        }
        .receipt-card {
            background: var(--card-dark); width: 90%; max-width: 420px; border-radius: 20px;
            padding: 35px; border: 3px solid var(--accent-gold); position: relative;
            max-height: 90vh; overflow-y: auto; animation: slideIn 0.4s ease;
        }
        @keyframes slideIn {
            from { transform: scale(0.8) translateY(-20px); opacity: 0; }
            to { transform: scale(1) translateY(0); opacity: 1; }
        }
        .close-btn {
            position: absolute; top: 15px; right: 20px; background: none;
            border: none; color: white; font-size: 28px; cursor: pointer; padding: 0;
        }
        .order-number {
            background: var(--accent-gold); color: #000; padding: 15px 30px;
            border-radius: 35px; font-weight: bold; font-size: 22px;
            margin: 0 auto 25px; display: block; text-align: center; letter-spacing: 2px;
        }
        .receipt-item {
            display: flex; justify-content: space-between; padding: 12px 0;
            border-bottom: 1px solid rgba(255,255,255,0.1); font-size: 14px;
        }
        .receipt-total {
            font-size: 26px; font-weight: bold; color: var(--accent-gold);
            margin: 20px 0 15px; padding-top: 15px; border-top: 2px solid var(--accent-gold);
            display: flex; justify-content: space-between;
        }
        .status-badge {
            display: inline-block; padding: 10px 25px; border-radius: 30px;
            font-weight: 700; font-size: 14px; margin: 15px auto; text-align: center;
        }
        .status-pending { background: linear-gradient(45deg, #f39c12, #e67e22); color: white; }

        .success-animation { text-align: center; padding: 20px; }
        .success-icon { font-size: 60px; color: #27ae60; margin-bottom: 15px; animation: pop 0.5s; }
        @keyframes pop { 0% { transform: scale(0); } 70% { transform: scale(1.2); } 100% { transform: scale(1); } }

        .empty-cart-icon {
            font-size: 50px;
            color: var(--text-dim);
            opacity: 0.5;
            margin-bottom: 15px;
        }
    </style>
</head>
<body>

    <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> Back to Menu</a>

    <div class="checkout-layout" id="checkoutLayout">
        <!-- Order Summary -->
        <div class="card">
            <h2>Your Order</h2>
            <div id="cart-items-container"></div>
            <div class="total-row">
                <span>Grand Total</span>
                <span>₱<span id="grand-total">0.00</span></span>
            </div>
        </div>

        <!-- Customer & Payment Details -->
        <div>
            <div class="card">
                <h3>Customer Details</h3>

                <div class="form-group">
                    <div class="field-wrapper" id="wrap-name">
                        <label>Full Name <span style="color: var(--accent-gold);">*</span></label>
                        <input type="text" id="cust-name" placeholder="Enter your full name">
                        <i class="fas fa-times-circle error-icon" title="Required"></i>
                        <small class="error-text">Please enter your full name</small>
                    </div>
                </div>

                <div class="form-group">
                    <div class="field-wrapper" id="wrap-phone">
                        <label>Contact Number</label>
                        <input type="tel" id="cust-phone" placeholder="09XXXXXXXXX">
                        <i class="fas fa-times-circle error-icon" title="Invalid format"></i>
                        <small class="error-text">Enter valid 11-digit number (09xxxxxxxxx)</small>
                    </div>
                </div>

                <div class="form-group">
                    <label>Order Type</label>
                    <select id="order-type">
                        <option value="Pickup">🏃 Pickup</option>
                        <option value="Dine-in">🍽️ Dine-in</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>Special Instructions</label>
                    <textarea id="cust-notes" rows="3" placeholder="Less ice, extra sugar, table number..."></textarea>
                </div>
            </div>

            <div class="card">
                <h3>Payment Method</h3>
                <div class="payment-options">
                    <div>
                        <input type="radio" name="payment" id="cash" value="Cash" class="payment-radio" checked onchange="togglePayment()">
                        <label for="cash" class="payment-label">
                            <i class="fas fa-wallet" style="margin-right: 5px;"></i> Cash
                        </label>
                    </div>
                    <div>
                        <input type="radio" name="payment" id="gcash" value="GCash" class="payment-radio" onchange="togglePayment()">
                        <label for="gcash" class="payment-label">
                            <i class="fas fa-mobile-alt" style="margin-right: 5px;"></i> GCash
                        </label>
                    </div>
                </div>

                                <div id="gcash-details">
                    <p style="font-size: 14px; margin-bottom: 10px; font-weight: 600;">Scan QR Code</p>
                    <img src="/images/QR Code.jpg" alt="GCash QR" style="width:180px; border-radius:10px; margin:10px 0;"
                         onerror="this.style.display='none'">

                    <div class="form-group">
                        <div class="field-wrapper" id="wrap-ref">
                            <label>Reference Number (13 digits)</label>
                            <input type="text" id="ref-num" placeholder="1234567890123" maxlength="13">
                            <i class="fas fa-times-circle error-icon" title="Required"></i>
                            <small class="error-text">Enter 13-digit GCash reference number</small>
                        </div>
                    </div>
                </div>

                <button class="btn-order" id="placeOrderBtn" onclick="placeOrder()">
                    <i class="fas fa-check"></i> Place Order (₱<span id="btn-total">0.00</span>)
                </button>
            </div>
        </div>
    </div>

    <!-- Receipt Modal -->
    <div class="receipt-modal" id="receiptModal">
        <div class="receipt-card">
            <div class="success-animation">
                <i class="fas fa-check-circle success-icon"></i>
            </div>
            <button class="close-btn" onclick="closeReceipt()">&times;</button>

            <div class="order-number" id="orderNumber">#0001</div>

            <div style="background: rgba(255,255,255,0.05); padding: 15px; border-radius: 10px; margin-bottom: 20px;">
                <p style="margin: 0; font-size: 13px; color: var(--text-dim);">Customer</p>
                <p style="margin: 5px 0 0; font-weight: 600;" id="receiptCustomer">Name</p>
                <p style="margin: 5px 0 0; font-size: 13px; color: var(--text-dim);" id="receiptPhone">Phone</p>
            </div>

            <div id="receiptItems" style="margin: 25px 0;"></div>

            <div class="receipt-total">
                <span>TOTAL:</span>
                <span id="receiptTotal">₱0.00</span>
            </div>

            <div class="status-badge status-pending" id="orderStatus">PENDING</div>

            <p style="font-size: 14px; color: var(--text-dim); text-align: center; margin: 20px 0;">
                📋 Show this order number to staff<br>
                <small>Track your order status in real-time</small>
            </p>

            <button class="btn-order" style="background: #2ecc71 !important;" onclick="window.location.href='/'">
                🏠 Back to Home
            </button>
        </div>
    </div>

        <script>
        // Load cart from localStorage
        let cart = JSON.parse(localStorage.getItem('simeonCart')) || [];

        function calculateTotal() {
            let subtotal = 0;
            cart.forEach(item => {
                subtotal += item.price * item.quantity;
            });
            return { subtotal, grandTotal: subtotal };
        }

        function renderOrder() {
            const container = document.getElementById('cart-items-container');
            const totals = calculateTotal();

            if (cart.length === 0) {
                container.innerHTML = `
                    <div style="text-align: center; padding: 40px 0;">
                        <i class="fas fa-shopping-cart empty-cart-icon"></i>
                        <p style="color: var(--text-dim);">Cart is empty</p>
                        <a href="/" style="color: var(--accent-gold);">Continue shopping</a>
                    </div>
                `;
                document.getElementById('placeOrderBtn').disabled = true;
                return;
            }

            document.getElementById('placeOrderBtn').disabled = false;

            container.innerHTML = cart.map((item, index) => `
                <div class="cart-item" data-index="${index}">
                    <div class="cart-item-details">
                        <strong>${item.name}</strong><br>
                        <span class="cart-item-qty">x${item.quantity}</span>
                        <small style="color: var(--text-dim);">@ ₱${item.price.toFixed(2)}</small>
                    </div>
                    <div style="text-align: right;">
                        ₱${(item.price * item.quantity).toFixed(2)}
                    </div>
                    <button class="remove-btn" onclick="removeFromCart(${index})" title="Remove item">
                        <i class="fas fa-times-circle"></i>
                    </button>
                </div>
            `).join('');

            document.getElementById('grand-total').textContent = totals.grandTotal.toFixed(2);
            document.getElementById('btn-total').textContent = totals.grandTotal.toFixed(2);
            return totals;
        }

        // Remove item from cart
        function removeFromCart(index) {
            cart.splice(index, 1);
            localStorage.setItem('simeonCart', JSON.stringify(cart));
            renderOrder();
        }

        function togglePayment() {
            document.getElementById('gcash-details').style.display =
                document.getElementById('gcash').checked ? 'block' : 'none';
        }

        // Show/Hide Error with X icon
        function setError(inputId, show) {
            const wrapper = inputId.parentElement;
            if (show) {
                wrapper.classList.add('has-error');
                inputId.classList.add('input-error');
            } else {
                wrapper.classList.remove('has-error');
                inputId.classList.remove('input-error');
            }
        }

        function validateForm() {
            let isValid = true;

            const nameInput = document.getElementById('cust-name');
            const phoneInput = document.getElementById('cust-phone');
            const refInput = document.getElementById('ref-num');
            const isGCash = document.getElementById('gcash').checked;

            // Reset errors
            setError(nameInput, false);
            setError(phoneInput, false);
            setError(refInput, false);

            // Validate name (required)
            if (!nameInput.value.trim()) {
                setError(nameInput, true);
                isValid = false;
            }

            // Validate phone (optional but must be valid if filled)
            const phone = phoneInput.value.trim();
            if (phone && !/^09\d{9}$/.test(phone)) {
                setError(phoneInput, true);
                isValid = false;
            }

            // Validate GCash reference (required if GCash)
            if (isGCash) {
                const ref = refInput.value.trim();
                if (!ref || !/^\d{13}$/.test(ref)) {
                    setError(refInput, true);
                    isValid = false;
                }
            }

            return isValid;
        }

        function generateOrderNumber() {
            const now = new Date();
            return `ORD-${now.getFullYear()}${String(now.getMonth()+1).padStart(2,'0')}${String(now.getDate()).padStart(2,'0')}-${String(Math.floor(Math.random()*1000)).padStart(3,'0')}`;
        }

        async function placeOrder() {
            if (!validateForm()) {
                // Shake animation on error
                const layout = document.getElementById('checkoutLayout');
                layout.style.animation = 'shake 0.5s';
                setTimeout(() => layout.style.animation = '', 500);
                return;
            }

            const btn = document.getElementById('placeOrderBtn');
            const totals = calculateTotal();
            
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Processing...';

            const orderNumber = generateOrderNumber();

            const orderData = {
                orderNumber: orderNumber,
                customerName: document.getElementById('cust-name').value.trim(),
                customerPhone: document.getElementById('cust-phone').value.trim() || null,
                orderType: document.getElementById('order-type').value,
                specialInstructions: document.getElementById('cust-notes').value.trim() || null,
                items: cart.map(item => ({
                    name: item.name,
                    price: item.price,
                    quantity: item.quantity
                })),
                subtotal: totals.subtotal,
                totalAmount: totals.grandTotal,
                paymentMethod: document.querySelector('input[name="payment"]:checked').value,
                refNumber: document.getElementById('gcash').checked ? document.getElementById('ref-num').value.trim() : null
            };

            try {
                // Add AbortController for timeout
                const controller = new AbortController();
                const timeoutId = setTimeout(() => controller.abort(), 10000); // 10 second timeout

                const response = await fetch('/api/orders', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(orderData),
                    signal: controller.signal
                });

                clearTimeout(timeoutId);

                const result = await response.json();

                if (!response.ok) {
                    throw new Error(result.message || 'Order failed');
                }

                // Show success modal
                showReceipt(orderData);

                // Clear cart
                localStorage.removeItem('simeonCart');
                cart = [];

            } catch (error) {
                console.error('Order Error:', error);
                
                let errorMessage = 'Something went wrong. Please try again.';
                
                if (error.name === 'AbortError') {
                    errorMessage = 'Request timed out. Please check your connection.';
                } else if (error.message) {
                    errorMessage = error.message;
                }
                
                alert('❌ ' + errorMessage);
                
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-check"></i> Place Order (₱' + totals.grandTotal.toFixed(2) + ')';
            }
        }

        function showReceipt(order) {
            document.getElementById('orderNumber').textContent = '#' + order.orderNumber;
            document.getElementById('receiptCustomer').textContent = order.customerName;
            document.getElementById('receiptPhone').textContent = order.customerPhone || '-';
            document.getElementById('receiptTotal').textContent = '₱' + order.totalAmount.toFixed(2);

            let itemsHTML = order.items.map(item => `
                <div class="receipt-item">
                    <span>${item.name} <small style="color: var(--text-dim);">(x${item.quantity})</small></span>
                    <span>₱${(item.price * item.quantity).toFixed(2)}</span>
                </div>
            `).join('');

            document.getElementById('receiptItems').innerHTML = itemsHTML;
            document.getElementById('receiptModal').style.display = 'flex';
        }

        function closeReceipt() {
            window.location.href = '/';
        }

        // Close modal on backdrop click
        document.getElementById('receiptModal').onclick = (e) => {
            if (e.target.id === 'receiptModal') closeReceipt();
        };

        // Add shake animation
        const style = document.createElement('style');
        style.textContent = `
            @keyframes shake {
                0%, 100% { transform: translateX(0); }
                25% { transform: translateX(-10px); }
                75% { transform: translateX(10px); }
            }
        `;
        document.head.appendChild(style);

        // Initialize
        renderOrder();
        togglePayment();
    </script>
</body>
</html>