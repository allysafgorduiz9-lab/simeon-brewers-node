<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Simeon Cafe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0f0f0f;
            --card-dark: #1a1a1a;
            --accent-gold: #C6A664;
            --text-light: #ffffff;
            --text-dim: #b3b3b3;
            --border: rgba(255,255,255,0.1);
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            margin: 0;
            padding: 40px 5%;
        }

        .checkout-layout {
            display: grid;
            grid-template-columns: 1fr 450px;
            gap: 30px;
            max-width: 1200px;
            margin: 0 auto;
        }

        @media (max-width: 950px) {
            .checkout-layout { grid-template-columns: 1fr; }
        }

        .card {
            background: var(--card-dark);
            border: 1px solid var(--border);
            border-radius: 20px;
            padding: 30px;
            margin-bottom: 20px;
        }

        h2, h3 { font-family: 'Playfair Display', serif; color: var(--accent-gold); margin-top: 0; margin-bottom: 20px; }

        /* --- Items List --- */
        .cart-item {
            display: flex;
            justify-content: space-between;
            padding: 12px 0;
            border-bottom: 1px solid var(--border);
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            font-size: 22px;
            font-weight: 600;
            color: var(--accent-gold);
        }

        /* --- Form Fields --- */
        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 13px; color: var(--text-dim); margin-bottom: 6px; }
        input, textarea, select {
            width: 100%;
            padding: 12px;
            background: #252525;
            border: 1px solid #444;
            border-radius: 10px;
            color: white;
            font-family: inherit;
            outline: none;
            box-sizing: border-box;
        }
        input:focus { border-color: var(--accent-gold); }

        /* --- Payment Toggle --- */
        .payment-options { display: flex; gap: 10px; margin: 15px 0; }
        .payment-options div { flex: 1; }
        .payment-radio { display: none; }
        .payment-label {
            border: 1px solid #333;
            padding: 12px;
            border-radius: 10px;
            text-align: center;
            cursor: pointer;
            display: block;
            font-size: 14px;
        }
        .payment-radio:checked + .payment-label {
            border-color: var(--accent-gold);
            background: rgba(198, 166, 100, 0.1);
            color: var(--accent-gold);
        }

        #gcash-details {
            display: none;
            text-align: center;
            background: #000;
            padding: 20px;
            border-radius: 15px;
            margin-top: 15px;
        }
        .qr-code { width: 180px; border-radius: 10px; margin: 10px 0; }

        .btn-order {
            background: var(--accent-gold);
            color: black;
            border: none;
            padding: 18px;
            border-radius: 12px;
            width: 100%;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            margin-top: 10px;
        }
        .back-link { color: var(--text-dim); text-decoration: none; display: inline-block; margin-bottom: 20px; }
    </style>
</head>
<body>

    <a href="/" class="back-link"><i class="fas fa-arrow-left"></i> Back to Menu</a>

    <div class="checkout-layout">
        <!-- Order Summary -->
        <div class="card">
            <h2>Your Order</h2>
            <div id="cart-items-container"></div>
            <div class="total-row">
                <span>Grand Total</span>
                <span>₱<span id="grand-total">0.00</span></span>
            </div>
        </div>

        <!-- Customer & Payment Details -->
        <div>
            <div class="card">
                <h3>Customer Details</h3>
                <div class="form-group">
                    <label>Full Name</label>
                    <input type="text" id="cust-name" placeholder="Juan Dela Cruz" required>
                </div>
                <div class="form-group">
                    <label>Contact Number</label>
                    <input type="tel" id="cust-phone" placeholder="0912 345 6789" required>
                </div>
                <div class="form-group">
                    <label>Order Type</label>
                    <select id="order-type">
                        <option value="Pickup">Pickup</option>
                        <option value="Dine-in">Dine-in</option>
                        <option value="Delivery">Delivery</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Notes / Address (if delivery)</label>
                    <textarea id="cust-notes" rows="2" placeholder="Ex: Extra sugar, or your complete address..."></textarea>
                </div>
            </div>

            <div class="card">
                <h3>Payment</h3>
                <div class="payment-options">
                    <div>
                        <input type="radio" name="payment" id="cash" value="Cash" class="payment-radio" checked onchange="togglePayment()">
                        <label for="cash" class="payment-label"><i class="fas fa-wallet"></i> Cash</label>
                    </div>
                    <div>
                        <input type="radio" name="payment" id="gcash" value="GCash" class="payment-radio" onchange="togglePayment()">
                        <label for="gcash" class="payment-label"><i class="fas fa-mobile-alt"></i> GCash</label>
                    </div>
                </div>

                <div id="gcash-details">
                    <p style="font-size: 12px; margin-bottom: 5px;">Scan to Pay</p>
                    <img src="/images/gcash-qr.png" alt="QR" class="qr-code" onerror="this.src='https://placehold.co/180x180?text=GCash+QR'">
                    <div class="form-group" style="text-align: left;">
                        <label>GCash Reference Number</label>
                        <input type="text" id="ref-num" placeholder="13-digit code">
                    </div>
                </div>

                <button class="btn-order" onclick="placeOrder()">Confirm Order</button>
            </div>
        </div>
    </div>

    <script>
        const cart = JSON.parse(localStorage.getItem('simeon_cart')) || [];
        
        function renderOrder() {
            const container = document.getElementById('cart-items-container');
            let total = 0;
            if (cart.length === 0) {
                container.innerHTML = `<p>Cart is empty</p>`;
                return;
            }
            container.innerHTML = cart.map(item => {
                total += item.price * item.quantity;
                return `
                    <div class="cart-item">
                        <span>${item.name} x ${item.quantity}</span>
                        <span>₱${(item.price * item.quantity).toLocaleString()}</span>
                    </div>
                `;
            }).join('');
            document.getElementById('grand-total').innerText = total.toLocaleString();
        }

        function togglePayment() {
            const isGCash = document.getElementById('gcash').checked;
            document.getElementById('gcash-details').style.display = isGCash ? 'block' : 'none';
        }

        function placeOrder() {
            const name = document.getElementById('cust-name').value;
            const phone = document.getElementById('cust-phone').value;
            const payMethod = document.querySelector('input[name="payment"]:checked').value;
            const ref = document.getElementById('ref-num').value;

            if (!name || !phone) {
                alert("Please fill in your name and contact number.");
                return;
            }

            if (payMethod === 'GCash' && !ref) {
                alert("Please provide the GCash Reference Number.");
                return;
            }

            // In a real app, you'd send this via fetch('/api/order', { method: 'POST', body: ... })
            alert(`Thank you, ${name}! Your ${payMethod} order is being processed.`);
            localStorage.removeItem('simeon_cart');
            window.location.href = '/';
        }
        

        renderOrder();
    </script>
</body>
</html>