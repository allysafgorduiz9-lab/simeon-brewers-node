<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout | Simeon Cafe</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0f0f0f;
            --card-dark: #1a1a1a;
            --accent-gold: #C6A664;
            --emerald: #2ecc71;
            --text-light: #ffffff;
            --text-dim: #b3b3b3;
        }

        body {
            font-family: 'Poppins', sans-serif;
            background-color: var(--bg-dark);
            color: var(--text-light);
            margin: 0;
            padding: 40px 8%;
        }

        .checkout-layout {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 40px;
            max-width: 1200px;
            margin: 0 auto;
        }

        @media (max-width: 900px) {
            .checkout-layout { grid-template-columns: 1fr; }
        }

        .card {
            background: var(--card-dark);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 30px;
        }

        h2, h3 { font-family: 'Playfair Display', serif; color: var(--accent-gold); margin-top: 0; }

        /* --- Order Summary --- */
        .cart-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .item-info h4 { margin: 0; font-weight: 400; }
        .item-info p { margin: 0; font-size: 12px; color: var(--text-dim); }

        .total-row {
            display: flex;
            justify-content: space-between;
            margin-top: 20px;
            font-size: 20px;
            font-weight: 600;
            color: var(--accent-gold);
        }

        /* --- Form Styling --- */
        .payment-options {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin: 20px 0;
        }

        .payment-radio { display: none; }
        .payment-label {
            border: 1px solid #333;
            padding: 15px;
            border-radius: 12px;
            text-align: center;
            cursor: pointer;
            display: block;
            font-weight: 600;
        }

        .payment-radio:checked + .payment-label {
            border-color: var(--accent-gold);
            background: rgba(198, 166, 100, 0.1);
            color: var(--accent-gold);
        }

        /* --- GCash Section --- */
        #gcash-details {
            display: none;
            text-align: center;
            background: rgba(0,0,0,0.3);
            padding: 20px;
            border-radius: 15px;
            margin-top: 15px;
        }

        .qr-code {
            width: 200px;
            height: 200px;
            margin: 10px auto;
            border: 5px solid white;
            border-radius: 10px;
        }

        .input-group { margin-top: 15px; text-align: left; }
        label { display: block; font-size: 12px; color: var(--text-dim); margin-bottom: 5px; }
        input {
            width: 100%;
            padding: 12px;
            background: #252525;
            border: 1px solid #444;
            border-radius: 8px;
            color: white;
            outline: none;
        }
        input:focus { border-color: var(--accent-gold); }

        .btn-order {
            background: var(--accent-gold);
            color: black;
            border: none;
            padding: 18px;
            border-radius: 12px;
            width: 100%;
            font-weight: 700;
            font-size: 16px;
            cursor: pointer;
            margin-top: 25px;
            text-transform: uppercase;
        }

        .btn-order:hover { transform: translateY(-2px); box-shadow: 0 5px 15px rgba(198, 166, 100, 0.2); }

        .back-link { color: var(--text-dim); text-decoration: none; font-size: 14px; margin-bottom: 20px; display: inline-block; }
        .back-link:hover { color: var(--accent-gold); }
    </style>
</head>
<body>

    <a href="/" class="back-link"><i class="fas fa-chevron-left"></i> Back to Menu</a>

    <div class="checkout-layout">
        <!-- Left Side: Order Review -->
        <div class="card">
            <h2>Order Review</h2>
            <div id="cart-items-container">
                <!-- Injected via JS -->
            </div>
            
            <div class="total-row">
                <span>Total Amount</span>
                <span>₱<span id="grand-total">0.00</span></span>
            </div>
        </div>

        <!-- Right Side: Payment -->
        <div class="card">
            <h3>Payment Method</h3>
            
            <div class="payment-options">
                <div>
                    <input type="radio" name="payment" id="cash" value="Cash" class="payment-radio" checked onchange="togglePayment()">
                    <label for="cash" class="payment-label">
                        <i class="fas fa-money-bill-wave"></i><br>Cash
                    </label>
                </div>
                <div>
                    <input type="radio" name="payment" id="gcash" value="GCash" class="payment-radio" onchange="togglePayment()">
                    <label for="gcash" class="payment-label">
                        <i class="fas fa-mobile-alt"></i><br>GCash
                    </label>
                </div>
            </div>

            <!-- GCash Hidden Area -->
            <div id="gcash-details">
                <p style="font-size: 13px;">Scan the QR code to pay</p>
                <img src="/images/gcash-qr.png" alt="GCash QR Code" class="qr-code" onerror="this.src='https://placehold.co/200x200?text=GCash+QR'">
                
                <div class="input-group">
                    <label for="ref-num">GCash Reference Number (Required)</label>
                    <input type="text" id="ref-num" placeholder="Enter 13-digit number">
                </div>
            </div>

            <button class="btn-order" onclick="placeOrder()">Place Order</button>
        </div>
    </div>

    <script>
        const cart = JSON.parse(localStorage.getItem('simeon_cart')) || [];
        
        function renderCart() {
            const container = document.getElementById('cart-items-container');
            let total = 0;

            if (cart.length === 0) {
                container.innerHTML = `<p style="color: var(--text-dim);">Your cart is empty.</p>`;
                return;
            }

            container.innerHTML = cart.map(item => {
                const subtotal = item.price * item.quantity;
                total += subtotal;
                return `
                    <div class="cart-item">
                        <div class="item-info">
                            <h4>${item.name}</h4>
                            <p>Quantity: ${item.quantity}</p>
                        </div>
                        <div style="font-weight: 600;">₱${subtotal.toLocaleString(undefined, {minimumFractionDigits: 2})}</div>
                    </div>
                `;
            }).join('');

            document.getElementById('grand-total').innerText = total.toLocaleString(undefined, {minimumFractionDigits: 2});
        }

        function togglePayment() {
            const gcashArea = document.getElementById('gcash-details');
            const isGCash = document.getElementById('gcash').checked;
            gcashArea.style.display = isGCash ? 'block' : 'none';
        }

        function placeOrder() {
            const paymentMethod = document.querySelector('input[name="payment"]:checked').value;
            const refNum = document.getElementById('ref-num').value.trim();

            if (cart.length === 0) {
                alert("Please add items to your cart first.");
                return;
            }

            if (paymentMethod === 'GCash' && refNum === '') {
                alert("Please enter the GCash Reference Number to confirm your payment.");
                return;
            }

            // Here you would typically send the data to your server via fetch()
            // For now, we simulate a success:
            alert(`Success! Your order via ${paymentMethod} has been placed.\nRef: ${refNum || 'N/A'}`);
            
            localStorage.removeItem('simeon_cart');
            window.location.href = '/';
        }

        // Initialize
        renderCart();
    </script>
</body>
</html>