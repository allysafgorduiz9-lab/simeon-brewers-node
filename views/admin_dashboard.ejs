<!DOCTYPE html>
<html>
<head>
    <title>Simeon Admin - Manage Menu</title>
    <link rel="stylesheet" href="/style.css">
    <style>
        /* Sidebar Styles */
        .nav-item { color: rgba(255,255,255,0.7); text-decoration: none; padding: 12px; border-radius: 8px; transition: 0.3s; font-size: 14px; display: block; }
        .nav-item:hover, .active { background: rgba(255,255,255,0.1); color: white; }
        
        /* Status Button Styles (FIXED: No logic inside CSS) */
        .status-btn { border: none; padding: 10px; border-radius: 20px; color: white; font-weight: bold; cursor: pointer; width: 100%; transition: 0.3s; }
        .btn-open { background-color: #27ae60; }
        .btn-closed { background-color: #e74c3c; }

        table { width: 100%; background: white; border-radius: 15px; border-collapse: collapse; box-shadow: 0 4px 15px rgba(0,0,0,0.05); overflow: hidden; }
        th { background: #2D1B14; color: white; padding: 15px; text-align: left; }
        td { padding: 15px; border-bottom: 1px solid #eee; }
    </style>
</head>
<body style="background: #F8F4F1; display: flex; margin: 0; font-family: 'Segoe UI', sans-serif;">

    <div style="width: 260px; background: #2D1B14; height: 100vh; color: white; padding: 25px; position: fixed; box-sizing: border-box;">
        <div style="text-align: center; margin-bottom: 30px;">
            <img src="/Simeon Cafe.jpg" style="width: 60px; border-radius: 50%; border: 2px solid #C6A664;">
            <h3 style="color: #C6A664; margin-top: 10px;">SIMEON BREWERS</h3>
            
            <div style="margin-top: 20px; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;">
                <p style="font-size: 11px; margin-bottom: 8px; color: #aaa;">STORE STATUS</p>
               <div style="margin-top: 20px; background: rgba(255,255,255,0.05); padding: 15px; border-radius: 12px;">
    <p style="font-size: 11px; margin-bottom: 8px; color: #aaa;">STORE STATUS</p>
    <button id="statusToggleBtn" class="status-btn <%= storeOpen ? 'btn-open' : 'btn-closed' %>">
        <%= storeOpen ? '● OPEN' : '○ CLOSED' %>
    </button>
</div>

<script>
document.getElementById('statusToggleBtn').addEventListener('click', function() {
    const btn = this;
    
    // Send a request to the server without refreshing
    fetch('/admin/toggle-status', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(response => response.json())
    .then(data => {
        // Update the button UI based on the response from the server
        if (data.storeOpen) {
            btn.innerText = '● OPEN';
            btn.className = 'status-btn btn-open';
        } else {
            btn.innerText = '○ CLOSED';
            btn.className = 'status-btn btn-closed';
        }
    })
    .catch(err => console.error('Error toggling status:', err));
});
</script>
            </div>
        </div>

        <nav>
            <a href="/admin/orders" class="nav-item">Active Orders</a>
            <a href="/admin/categories" class="nav-item">Manage Categories</a>
            <a href="/admin/menu" class="nav-item active">Manage Menu</a>
            <a href="/admin/reports" class="nav-item">Daily Reports</a>
            <hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.1); margin: 15px 0;">
            <a href="/" target="_blank" class="nav-item" style="color: #C6A664; border: 1px solid rgba(198, 166, 100, 0.3); margin-top: 10px; text-align: center;">
    View Live Site ↗
</a>
<hr style="border: 0; border-top: 1px solid rgba(255,255,255,0.1); margin: 15px 0;">
<a href="/logout" class="nav-item" style="color: #ff7675;">Logout</a>
        </nav>
    </div>

    <div style="margin-left: 260px; padding: 40px; width: 100%;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 30px;">
            <h2 style="color: #2D1B14; margin: 0;">Inventory Management</h2>
            <a href="/admin/add-product" style="background: #2D1B14; color: #C6A664; padding: 10px 20px; border-radius: 8px; text-decoration: none; font-weight: bold;">+ Add New Menu</a>
        </div>

        <table>
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th style="text-align: center;">Action</th>
                </tr>
            </thead>
           <tbody>
    <% if (products && products.length > 0) { %>
        <% products.forEach(p => { %>
       <tr>
    <td style="display: flex; align-items: center; gap: 15px;">
        <img src="/images/<%= p.image %>" width="50" height="50" style="border-radius: 8px; object-fit: cover;">
        <strong><%= p.name %></strong>
    </td>
    <td><%= p.category %></td>
    <td style="color: #C6A664; font-weight: 600;">₱<%= p.price_1 %></td>
    <td style="text-align: center;">
        <a href="/admin/edit-product/<%= p.id %>" 
           style="color: #3498db; text-decoration: none; font-weight: bold; margin-right: 15px;">
           Edit
        </a>
        <a href="/admin/delete/<%= p.id %>" 
           onclick="return confirm('Delete this product?')" 
           style="color: #e74c3c; text-decoration: none; font-weight: bold;">
           Delete
        </a>
    </td>
</tr>
        <% }); %>
    <% } else { %>
        <tr><td colspan="4" style="text-align: center; color: #888; padding: 20px;">No menu items found.</td></tr>
    <% } %>
</tbody>
        </table>
    </div>
</body>
</html>