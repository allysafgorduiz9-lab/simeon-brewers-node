<!DOCTYPE html>
<html>
<head>
    <script src="/js/admin.js"></script>
    <title>Simeon Admin - Manage Menu</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { box-sizing: border-box; }
        body { 
            background: linear-gradient(135deg, #F8F4F1 0%, #F5EDE3 100%); 
            margin: 0; 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; 
            min-height: 100vh;
            display: flex;
        }
        
        .sidebar {
            width: 280px; 
            background: linear-gradient(180deg, #2D1B14 0%, #1A0F0A 100%);
            height: 100vh; 
            color: white; 
            padding: 30px 25px;
            position: fixed;
            box-shadow: 4px 0 20px rgba(45, 27, 20, 0.3);
            overflow-y: auto;
        }
        
        .logo-section {
            text-align: center; 
            margin-bottom: 35px; 
            padding-bottom: 25px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
        }
        
        .logo-img {
            width: 65px; 
            height: 65px; 
            border-radius: 50%; 
            border: 3px solid #C6A664;
            margin-bottom: 12px;
            box-shadow: 0 4px 15px rgba(198, 166, 100, 0.3);
        }
        
        .logo-title {
            color: #C6A664; 
            margin: 0 0 15px 0;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: 0.5px;
        }
        
        .store-status {
            background: rgba(255,255,255,0.08); 
            padding: 20px; 
            border-radius: 16px;
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255,255,255,0.1);
        }
        
        .status-label {
            font-size: 12px; 
            margin-bottom: 12px; 
            color: rgba(255,255,255,0.6);
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        
        .status-btn { 
            border: none; 
            padding: 14px 20px; 
            border-radius: 25px; 
            color: white; 
            font-weight: 600;
            font-size: 14px;
            cursor: pointer; 
            width: 100%; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.3px;
            backdrop-filter: blur(10px);
        }
        
        .status-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        }
        
        .btn-open { 
            background: linear-gradient(135deg, #27ae60, #2ecc71); 
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.4);
        }
        
        .btn-closed { 
            background: linear-gradient(135deg, #e74c3c, #c0392b); 
            box-shadow: 0 4px 15px rgba(231, 76, 60, 0.4);
        }
        
        .nav-section {
            margin-top: 25px;
        }
        
        .nav-item { 
            color: rgba(255,255,255,0.75); 
            text-decoration: none; 
            padding: 14px 18px; 
            border-radius: 12px; 
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            font-size: 15px; 
            font-weight: 500;
            display: block; 
            margin-bottom: 8px;
            position: relative;
            overflow: hidden;
        }
        
        .nav-item::before {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            width: 4px;
            height: 0;
            background: #C6A664;
            transition: height 0.3s ease;
        }
        
        .nav-item:hover::before,
        .nav-item.active::before {
            height: 100%;
        }
        
        .nav-item:hover, 
        .nav-item.active { 
            background: rgba(255,255,255,0.12); 
            color: white; 
            transform: translateX(4px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        
        .nav-divider {
            border: 0; 
            border-top: 1px solid rgba(255,255,255,0.12); 
            margin: 25px 0;
        }
        
        .live-site-link {
            color: #C6A664 !important;
            border: 2px solid rgba(198, 166, 100, 0.3);
            background: rgba(198, 166, 100, 0.1);
            text-align: center;
            font-weight: 600;
            margin-top: 10px;
        }
        
        .live-site-link:hover {
            background: rgba(198, 166, 100, 0.2);
            border-color: rgba(198, 166, 100, 0.6);
            transform: translateX(4px) !important;
        }
        
        .logout-link {
            color: #ff7675 !important;
            font-weight: 600;
        }
        
        .logout-link:hover {
            background: rgba(255, 118, 117, 0.1);
            border-color: rgba(255, 118, 117, 0.3);
        }
        
        .main-content {
            margin-left: 280px; 
            padding: 50px; 
            width: calc(100% - 280px);
            min-height: 100vh;
            max-width: 1600px;
        }
        
        .page-header-section {
            display: flex; 
            justify-content: space-between; 
            align-items: center; 
            margin-bottom: 40px;
            flex-wrap: wrap;
            gap: 20px;
        }
        
        .page-header {
            color: #2D1B14; 
            font-size: 36px;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin: 0;
        }
        
        .btn-add { 
            background: linear-gradient(135deg, #2D1B14, #3A271C); 
            color: #F0E6D2; 
            border: none; 
            padding: 16px 32px; 
            border-radius: 16px; 
            font-weight: 700;
            cursor: pointer; 
            font-size: 15px;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            letter-spacing: 0.5px;
            box-shadow: 0 6px 20px rgba(45, 27, 20, 0.3);
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 10px;
        }
        
        .btn-add:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 30px rgba(45, 27, 20, 0.4);
            background: linear-gradient(135deg, #3A271C, #4D3528);
        }
        
        .card { 
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(20px);
            padding: 0;
            border-radius: 24px; 
            box-shadow: 0 20px 60px rgba(45, 27, 20, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.3);
            overflow: hidden;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        
        table { 
            width: 100%; 
            border-collapse: separate; 
            border-spacing: 0;
        }
        
        th { 
            text-align: left; 
            padding: 25px 20px; 
            background: linear-gradient(135deg, #2D1B14, #3A271C);
            color: white; 
            font-weight: 600;
            font-size: 15px;
            letter-spacing: 0.3px;
        }
        
        td { 
            padding: 25px 20px; 
            border-bottom: 1px solid rgba(232, 220, 202, 0.3);
            transition: all 0.2s ease;
        }
        
        tr:hover td {
            background: rgba(198, 166, 100, 0.06);
            transform: translateX(4px);
        }
        
        .product-image {
            width: 60px;
            height: 60px;
            border-radius: 16px;
            object-fit: cover;
            box-shadow: 0 6px 20px rgba(0,0,0,0.1);
            border: 3px solid rgba(198, 166, 100, 0.2);
        }
        
        .product-name {
            font-weight: 700;
            color: #2D1B14;
            font-size: 18px;
            margin: 0;
        }
        
        .category-badge {
            background: linear-gradient(135deg, #E8DCCA, #F0E6D2);
            color: #2D1B14;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: 600;
            display: inline-block;
            box-shadow: 0 4px 12px rgba(232, 220, 202, 0.4);
        }
        
        .price {
            color: #2D1B14;
            font-weight: 700;
            font-size: 20px;
            background: linear-gradient(135deg, #C6A664, #D4B085);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        
        .action-buttons {
            display: flex;
            gap: 12px;
            justify-content: center;
        }
        
        .btn-edit {
            color: #3498db; 
            text-decoration: none; 
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 12px;
            background: rgba(52, 152, 219, 0.1);
            border: 2px solid rgba(52, 152, 219, 0.3);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
        }
        
        .btn-edit:hover {
            background: rgba(52, 152, 219, 0.2);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(52, 152, 219, 0.2);
        }
        
        .btn-delete {
            color: #e74c3c; 
            text-decoration: none; 
            font-weight: 600;
            padding: 10px 20px;
            border-radius: 12px;
            background: rgba(231, 76, 60, 0.1);
            border: 2px solid rgba(231, 76, 60, 0.3);
            transition: all 0.3s ease;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 14px;
        }
        
        .btn-delete:hover {
            background: rgba(231, 76, 60, 0.2);
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(231, 76, 60, 0.2);
        }
        
        .empty-state {
            text-align: center; 
            padding: 80px 40px;
            color: #8D6E63;
        }
        
        .empty-state i { 
            font-size: 64px; 
            display: block; 
            margin-bottom: 25px; 
            opacity: 0.4;
            color: #C6A664;
        }
        
        .empty-state h3 {
            color: #2D1B14;
            margin-bottom: 15px;
            font-size: 28px;
            font-weight: 700;
        }
        
        @media (max-width: 768px) {
            .page-header-section {
                flex-direction: column;
                text-align: center;
            }
            .sidebar { width: 260px; }
            .main-content { margin-left: 260px; padding: 30px 20px; }
            th, td { padding: 20px 15px; }
            .action-buttons { flex-direction: column; width: 100%; }
        }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo-section">
            <img src="/Simeon Cafe.jpg" class="logo-img" alt="Simeon Brewers" onerror="this.src='https://via.placeholder.com/65x65/2D1B14/C6A664?text=S'">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <div class="status-label">STORE STATUS</div>
                <form action="/admin/toggle-status" method="POST">
                    <button type="submit" class="status-btn <%= storeOpen ? 'btn-open' : 'btn-closed' %>">
                        <%= storeOpen ? '● OPEN' : '○ CLOSED' %>
                    </button>
                </form>
            </div>
        </div>
        
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item">
                <i class="fas fa-list"></i> Active Orders
            </a>
            <a href="/admin/categories" class="nav-item">
                <i class="fas fa-tags"></i> Manage Categories
            </a>
            <a href="/admin/menu" class="nav-item active">
                <i class="fas fa-utensils"></i> Manage Menu
            </a>
            <a href="/admin/reports" class="nav-item">
                <i class="fas fa-chart-bar"></i> Daily Reports
            </a>
            
            <hr class="nav-divider">
            
            <a href="/" target="_blank" class="nav-item live-site-link">
                <i class="fas fa-external-link-alt"></i> View Live Site ↗
            </a>
            
            <hr class="nav-divider">
            
            <a href="/logout" class="nav-item logout-link">
                <i class="fas fa-sign-out-alt"></i> Logout
            </a>
        </div>
    </div>

    <div class="main-content">
        <div class="page-header-section">
            <h1 class="page-header">
                <i class="fas fa-utensils"></i> 
                Inventory Management
            </h1>
            <a href="/admin/add-product" class="btn-add">
                <i class="fas fa-plus"></i> Add New Item
            </a>
        </div>

        <div class="card">
            <% if (products && products.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th style="width: 300px;">Product</th>
                            <th style="width: 200px;">Category</th>
                            <th style="width: 150px;">Price</th>
                            <th style="text-align: center; width: 250px;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(p => { %>
                        <tr>
                            <td style="display: flex; align-items: center; gap: 20px;">
                                <img src="/images/<%= p.image %>" 
                                     class="product-image" 
                                     alt="<%= p.name %>"
                                     onerror="this.src='/images/default.jpg'">
                                <div class="product-name"><%= p.name %></div>
                            </td>
                            <td>
                                <span class="category-badge"><%= p.category %></span>
                            </td>
                            <td>
                                <div class="price">₱<%= p.price_1 %></div>
                            </td>
                            <td>
                                <div class="action-buttons">
                                    <a href="/admin/edit-product/<%= p.id %>" class="btn-edit">
                                        <i class="fas fa-edit"></i> Edit
                                    </a>
                                    <a href="/admin/delete/<%= p.id %>" 
                                       onclick="return confirm('Are you sure you want to delete this item? All orders containing it will be affected.')"
                                       class="btn-delete">
                                        <i class="fas fa-trash"></i> Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                        <% }); %>
                    </tbody>
                </table>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-utensils"></i>
                    <h3>No Menu Items</h3>
                    <p style="font-size: 16px; margin-bottom: 30px;">Your menu is empty. Add your first item to get started!</p>
                </div>
            <% } %>
        </div>
    </div>

    <script>
        // Real-time store status toggle
        document.querySelector('.status-btn').addEventListener('click', async function(e) {
            e.preventDefault();
            
            const btn = this;
            const wasOpen = btn.classList.contains('btn-open');
            
            btn.textContent = '⏳ UPDATING...';
            btn.style.opacity = '0.7';
            
            try {
                const response = await fetch('/admin/toggle-status', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                
                if (data.storeOpen) {
                    btn.className = 'status-btn btn-open';
                    btn.textContent = '● OPEN';
                } else {
                    btn.className = 'status-btn btn-closed';
                    btn.textContent = '○ CLOSED';
                }
                
                window.storeOpen = data.storeOpen;
                console.log('✅ Store status updated:', data.storeOpen ? 'OPEN' : 'CLOSED');
                
            } catch (error) {
                console.error('Status update failed:', error);
                if (wasOpen) {
                    btn.className = 'status-btn btn-open';
                    btn.textContent = '● OPEN';
                } else {
                    btn.className = 'status-btn btn-closed';
                    btn.textContent = '○ CLOSED';
                }
            }
            
            btn.style.opacity = '1';
        });
    </script>
</body>
</html>