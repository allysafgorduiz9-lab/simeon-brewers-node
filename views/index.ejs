<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simeon Cafe | Premium Coffee Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0f0f0f;
            --card-dark: #1a1a1a;
            --accent-gold: #C6A664;
            --accent-hover: #e0c285;
            --text-light: #ffffff;
            --text-dim: #b3b3b3;
            --primary-brown: #5D4037;
            --status-green: #27ae60;
            --danger: #e74c3c;
            --fb-blue: #1877F2;
        }

        * { box-sizing: border-box; transition: all 0.3s ease; }

        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            background-color: var(--bg-dark);
            color: var(--text-light);
            scroll-behavior: smooth;
        }

        /* --- Header & Navigation --- */
        header {
            background-color: rgba(15, 15, 15, 0.98);
            padding: 15px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
        }

        .logo-section { display: flex; align-items: center; }
        .logo-section img { border-radius: 8px; margin-right: 15px; border: 1px solid var(--accent-gold); }
        .brand-name h1 { font-family: 'Playfair Display', serif; font-size: 20px; margin: 0; letter-spacing: 1px; color: var(--text-light); }
        .brand-name p { font-size: 9px; margin: 0; color: var(--accent-gold); font-weight: 600; text-transform: uppercase; }

        .status-pill {
            background: var(--status-green);
            color: white;
            padding: 3px 10px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: bold;
            margin-top: 5px;
            display: inline-block;
        }
        .status-pill.closed { background: var(--danger); }

        nav { display: flex; align-items: center; gap: 25px; }
        nav a { color: var(--text-light); text-decoration: none; font-size: 13px; font-weight: 600; }
        nav a:hover { color: var(--accent-gold); }

        .nav-actions { display: flex; align-items: center; gap: 12px; }

        .login-btn, .cart-btn {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 8px 14px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: var(--text-light);
            text-decoration: none;
        }

        .login-btn:hover, .cart-btn:hover {
            border-color: var(--accent-gold);
            background: rgba(198, 166, 100, 0.05);
        }

        /* --- Hero Section --- */
        .hero {
            height: 65vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.9)), url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&q=80&w=1920'); 
            background-size: cover;
            background-position: center;
            padding: 0 10%;
        }

        .hero h2 { font-family: 'Playfair Display', serif; font-size: clamp(32px, 5vw, 52px); margin-bottom: 15px; }
        .hero h2 span { color: var(--accent-gold); }
        .hero p { color: var(--text-dim); line-height: 1.8; max-width: 650px; font-weight: 300; }

        /* --- Menu Section --- */
        .menu-container { padding: 80px 8%; }
        .section-title { text-align: center; margin-bottom: 50px; }
        .section-title h3 { color: var(--accent-gold); letter-spacing: 3px; font-size: 14px; text-transform: uppercase; }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
        }

        .product-card {
            background: var(--card-dark);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            position: relative;
        }
        .product-card:hover { transform: translateY(-8px); border-color: var(--accent-gold); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }

        .product-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 15px;
            margin-bottom: 20px;
        }

        .product-name { font-family: 'Playfair Display', serif; font-size: 22px; margin: 10px 0; color: var(--text-light); }
        .product-price { color: var(--accent-gold); font-size: 18px; font-weight: 600; margin-bottom: 20px; }

        .btn-add {
            background: var(--accent-gold);
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 12px;
            width: 100%;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-add:hover:not(:disabled) { background: var(--accent-hover); transform: scale(1.02); }
        .btn-add:disabled { 
            background: #2a2a2a !important; 
            color: #666 !important; 
            cursor: not-allowed !important; 
            opacity: 0.5;
        }

        .qty-input {
            width: 60px;
            background: #252525;
            color: white;
            border: 1px solid #444;
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            font-family: inherit;
        }
        .qty-input:disabled { background: #1a1a1a; opacity: 0.5; }

        /* --- Pagination Styling --- */
        .pagination { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 50px; }
        .nav-btn {
            padding: 10px 20px;
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 8px;
            background: rgba(255,255,255,0.03);
            color: var(--accent-gold);
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
            transition: 0.3s;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .nav-btn:hover:not(.disabled) {
            border-color: var(--accent-gold);
            background: rgba(198, 166, 100, 0.1);
            transform: translateY(-2px);
        }
        .nav-btn.disabled {
            pointer-events: none;
            opacity: 0.3;
            color: var(--text-dim);
        }

        /* --- Footer --- */
        footer {
            background: #000;
            padding: 80px 8% 30px;
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: 80px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 50px;
            margin-bottom: 50px;
        }
        .footer-col h4 { color: var(--accent-gold); margin-bottom: 25px; font-size: 16px; letter-spacing: 1px; font-family: 'Playfair Display', serif; }
        .footer-col p, .footer-col a { color: var(--text-dim); font-size: 14px; text-decoration: none; line-height: 1.8; margin-bottom: 12px; }
        .footer-col a:hover { color: var(--accent-gold); padding-left: 5px; }
        .footer-bottom { text-align: center; border-top: 1px solid #1a1a1a; padding-top: 30px; font-size: 11px; color: #444; letter-spacing: 1px; }

        .fb-btn {
            background: var(--fb-blue);
            color: white !important;
            padding: 10px 20px;
            border-radius: 8px;
            display: inline-flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            margin-top: 15px;
            text-decoration: none;
        }
        .fb-btn:hover { background: #1565c0; transform: scale(1.05); }
    </style>
</head>
<body>

<header>
    <div class="logo-section">
        <img src="/Simeon Cafe.jpg" width="45" alt="Simeon Logo" onerror="this.style.display='none'">
        <div class="brand-name">
            <h1>SIMEON CAFE</h1>
            <p>Premium Coffee Shop</p>
            <span class="status-pill" id="status-pill">
                <%= storeOpen ? 'OPEN NOW' : 'CLOSED' %>
            </span>
        </div>
    </div>
    <nav>
        <a href="/">HOME</a>
        <a href="#menu">MENU</a>
        <a href="#about">ABOUT</a>
        
        <div class="nav-actions">
            <a href="/login" class="login-btn" title="Staff Login">
                <i class="fas fa-user-circle"></i>
            </a>
            <div class="cart-btn" onclick="checkout()">
                <i class="fas fa-shopping-cart" style="color: var(--accent-gold);"></i>
                <span id="cart-count">0</span>
            </div>
        </div>
    </nav>
</header>

<section class="hero">
    <h2>Welcome to <span>Simeon Cafe</span></h2>
    <p>Experience the finest handcrafted coffee and treats in Silago.</p>
</section>

<div class="menu-container" id="menu">
    <div class="section-title">
        <h3>Discover Our Favorites</h3>
    </div>

    <div class="product-grid">
        <% if (products && products.length > 0) { %>
            <% 
               const itemsPerPage = 8;
               const currentPage = typeof page !== '' ? parseInt(page) : 1;
               const start = (currentPage - 1) * itemsPerPage;
               const end = start + itemsPerPage;
               const paginatedItems = products.slice(start, end);
               const totalPages = Math.ceil(products.length / itemsPerPage);
            %>

            <% paginatedItems.forEach(p => { %>
                <div class="product-card">
                    <img src="/images/<%= p.image %>" class="product-img" onerror="this.src='https://images.unsplash.com/photo-1509042239860-f550ce710b93?q=80&w=400'">
                    <div class="product-name"><%= p.name %></div>
                    
                    <div class="product-price">
                        ₱<%= (p.price_1 || p.price || 0).toLocaleString(undefined, {minimumFractionDigits: 2}) %>
                    </div>
                    
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <input type="number" value="1" min="1" id="qty-<%= p.id %>" class="qty-input">
                        
                        <button class="btn-add"
                                data-id="<%= p.id %>"
                                data-name="<%= p.name %>"
                                data-price="<%= p.price_1 || p.price || 0 %>"
                                onclick="addToCart(this)"
                                id="btn-<%= p.id %>">
                            ADD TO CART
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: var(--text-dim);">No items available.</p>
        <% } %>
    </div>

    <!-- Navigation Arrows -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
        <div class="pagination">
            <a href="?page=<%= currentPage - 1 %>" class="nav-btn <%= currentPage <= 1 ? 'disabled' : '' %>">
                <i class="fas fa-arrow-left"></i> Previous
            </a>
            
            <span style="font-size: 14px; color: var(--accent-gold); font-weight: bold;">
                Page <%= currentPage %> of <%= totalPages %>
            </span>

            <a href="?page=<%= currentPage + 1 %>" class="nav-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">
                Next <i class="fas fa-arrow-right"></i>
            </a>
        </div>
    <% } %>

    <!-- Explore Button -->
    <div style="text-align: center; margin-top: 40px;">
        <a href="#menu" class="login-btn" style="display: inline-block; padding: 12px 35px; border-color: var(--accent-gold); color: var(--accent-gold);">
            EXPLORE FULL MENU
        </a>
    </div>
</div>

<footer>
    <div class="footer-grid">
        <div class="footer-col">
            <h4>OUR STORY</h4>
            <p>Simeon Cafe brings the finest beans to Silago for an unparalleled coffee experience.</p>
            
            <a href="https://www.facebook.com/profile.php?id=100092630560572" target="_blank" class="fb-btn">
                <i class="fab fa-facebook-f"></i> Like us on Facebook
            </a>
        </div>
        <div class="footer-col">
            <h4>EXPLORE</h4>
            <a href="/">Home</a>
            <a href="#menu">Full Menu</a>
            <a onclick="checkout()" style="cursor: pointer;" id="cart-footer-link">My Cart</a>
            <a href="/login">Staff Portal</a>
        </div>
        <div class="footer-col">
            <h4>CONTACT</h4>
            <p><i class="fas fa-map-marker-alt" style="color: var(--accent-gold);"></i> Poblacion District 1, Silago</p>
            <p><i class="fas fa-phone" style="color: var(--accent-gold);"></i> 0977 105 3180</p>
        </div>
        <div class="footer-col">
            <h4>VISIT US</h4>
            <p>Monday - Sunday</p>
            <p>8:00 AM - 10:00 PM</p>
            <div style="display: flex; gap: 15px; margin-top: 15px; font-size: 18px;">
                <a href="https://www.facebook.com/profile.php?id=100092630560572" target="_blank" style="color: var(--accent-gold);"><i class="fab fa-facebook"></i></a>
                <a href="#" style="color: var(--accent-gold);"><i class="fab fa-instagram"></i></a>
            </div>
        </div>
    </div>
    <div class="footer-bottom">
        &copy; 2026 SIMEON CAFE. ALL RIGHTS RESERVED.
    </div>
</footer>

<script>
    // FIXED: Robust store status management
    let cart = JSON.parse(localStorage.getItem('simeon_cart')) || [];
    let isStoreOpen = <%- JSON.stringify(!!storeOpen) %>; // ✅ FIXED: Safe boolean serialization
    
    // Initialize UI
    updateCartCount();
    updateStoreStatusUI();

    // 🔥 IMPROVED: More reliable real-time store status
    async function updateStoreStatus() {
        try {
            const response = await fetch('/api/status', { 
                cache: 'no-cache',
                headers: { 'Cache-Control': 'no-cache' }
            });
            
            if (!response.ok) throw new Error('Status API failed');
            
            const data = await response.json();
            isStoreOpen = !!data.storeOpen; // Ensure boolean
            
            updateStoreStatusUI();
            console.log('✅ Store status:', isStoreOpen ? 'OPEN' : 'CLOSED');
            
        } catch (error) {
            console.error('❌ Status check failed:', error);
            // Keep current status if API fails (don't break UX)
        }
    }

    // ✅ FIXED: Update ALL store status elements reliably
    function updateStoreStatusUI() {
        // Status pill
        const statusPill = document.getElementById('status-pill');
        if (statusPill) {
            statusPill.textContent = isStoreOpen ? 'OPEN NOW' : 'CLOSED';
            statusPill.className = `status-pill ${isStoreOpen ? '' : 'closed'}`;
        }
        
        // Add to cart buttons
        document.querySelectorAll('.btn-add').forEach(btn => {
            btn.disabled = !isStoreOpen;
            btn.textContent = isStoreOpen ? 'ADD TO CART' : 'STORE CLOSED';
            btn.style.opacity = isStoreOpen ? '1' : '0.6';
        });
        
        // Quantity inputs
        document.querySelectorAll('.qty-input').forEach(input => {
            input.disabled = !isStoreOpen;
        });
        
        // Cart buttons/links (header + footer)
        document.querySelectorAll('.cart-btn, #cart-footer-link').forEach(link => {
            if (isStoreOpen) {
                link.style.opacity = '1';
                link.style.pointerEvents = 'auto';
                link.classList.remove('disabled');
            } else {
                link.style.opacity = '0.5';
                link.style.pointerEvents = 'none';
                link.classList.add('disabled');
            }
        });
    }

    // 🔥 BETTER POLLING: Exponential backoff + visibility detection
    function startStatusPolling() {
        // Initial check after 2 seconds
        setTimeout(updateStoreStatus, 2000);
        
        // Poll every 30 seconds
        setInterval(updateStoreStatus, 30000);
        
        // Check when user returns to tab
        document.addEventListener('visibilitychange', () => {
            if (!document.hidden) {
                updateStoreStatus();
            }
        });
        
        // Check on page focus
        window.addEventListener('focus', updateStoreStatus);
    }

    // Start polling
    startStatusPolling();

    // FIXED: Safe cart operations
    function addToCart(button) {
        if (!isStoreOpen) {
            // Visual feedback instead of blocking alert
            button.style.animation = 'shake 0.5s';
            setTimeout(() => button.style.animation = '', 500);
            return;
        }
        
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');
        const price = parseFloat(button.getAttribute('data-price'));
        const qtyInput = document.getElementById('qty-' + id);
        const qty = Math.max(1, parseInt(qtyInput.value) || 1);

        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity = Math.min(99, existing.quantity + qty); // Cap at 99
        } else {
            cart.push({ id, name, price, quantity: qty });
        }
        
        localStorage.setItem('simeon_cart', JSON.stringify(cart));
        updateCartCount();
        
        // Reset quantity & visual feedback
        qtyInput.value = 1;
        button.textContent = 'ADDED!';
        button.style.background = '#27ae60';
        setTimeout(() => {
            button.textContent = 'ADD TO CART';
            button.style.background = '';
        }, 1000);
    }

    function updateCartCount() {
        const total = cart.reduce((sum, item) => sum + item.quantity, 0);
        const countEl = document.getElementById('cart-count');
        if (countEl) {
            countEl.textContent = total;
            countEl.style.display = total > 0 ? 'inline' : 'none';
        }
    }

    function checkout() {
        if (!isStoreOpen) {
            const cartBtn = document.querySelector('.cart-btn');
            cartBtn.style.animation = 'shake 0.5s';
            setTimeout(() => cartBtn.style.animation = '', 500);
            return;
        }
        window.location.href = '/checkout';
    }

    // Add shake animation for closed store feedback
    const style = document.createElement('style');
    style.textContent = `
        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }
    `;
    document.head.appendChild(style);
</script>
</body>
</html>