<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simeon Cafe | Premium Coffee Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root {
            --bg-dark: #121212;
            --card-dark: #1a1a1a;
            --accent-gold: #C6A664;
            --text-light: #ffffff;
            --text-dim: #b3b3b3;
            --primary-brown: #5D4037;
            --status-green: #27ae60;
        }

        body {
            font-family: 'Segoe UI', Roboto, sans-serif;
            margin: 0;
            background-color: var(--bg-dark);
            color: var(--text-light);
            scroll-behavior: smooth;
        }

        /* --- Header & Navigation --- */
        header {
            background-color: rgba(18, 18, 18, 0.95);
            padding: 15px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid #333;
        }

        .logo-section { display: flex; align-items: center; }
        .logo-section img { border-radius: 5px; margin-right: 15px; border: 1px solid var(--accent-gold); }
        .brand-name h1 { font-size: 18px; margin: 0; letter-spacing: 1px; color: var(--text-light); }
        .brand-name p { font-size: 10px; margin: 0; color: var(--accent-gold); font-weight: bold; }

        .status-pill {
            background: var(--status-green);
            color: white;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: bold;
            margin-top: 5px;
            display: inline-block;
        }
        .status-pill.closed { background: #e74c3c; }

        nav { display: flex; align-items: center; gap: 30px; }
        nav a { color: var(--text-light); text-decoration: none; font-size: 13px; font-weight: bold; transition: 0.3s; cursor: pointer; }
        nav a:hover { color: var(--accent-gold); }

        .cart-btn {
            background: rgba(255,255,255,0.05);
            border: 1px solid #444;
            padding: 8px 15px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        /* --- Hero Section --- */
        .hero {
            height: 60vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: linear-gradient(rgba(0,0,0,0.6), rgba(0,0,0,0.8)), url('/images/hero-bg.jpg'); /* Add a nice coffee bg */
            background-size: cover;
            background-position: center;
            padding: 0 20%;
        }

        .hero h2 { font-size: 42px; margin-bottom: 10px; }
        .hero h2 span { color: var(--accent-gold); }
        .hero p { color: var(--text-dim); line-height: 1.6; max-width: 600px; }

        /* --- Menu Section --- */
        .menu-container { padding: 60px 8%; }
        .section-title { text-align: center; margin-bottom: 50px; }
        .section-title h3 { color: var(--accent-gold); letter-spacing: 2px; font-size: 14px; text-transform: uppercase; }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
        }

        .product-card {
            background: var(--card-dark);
            border: 1px solid #333;
            border-radius: 15px;
            padding: 20px;
            transition: transform 0.3s, border-color 0.3s;
            text-align: center;
        }
        .product-card:hover { transform: translateY(-5px); border-color: var(--accent-gold); }

        .product-img {
            width: 100%;
            height: 200px;
            object-fit: cover;
            border-radius: 10px;
            margin-bottom: 15px;
        }

        .product-name { font-size: 20px; margin: 10px 0; color: var(--text-light); }
        .product-price { color: var(--accent-gold); font-size: 18px; font-weight: bold; margin-bottom: 20px; }

        .btn-add {
            background: var(--primary-brown);
            color: white;
            border: none;
            padding: 12px;
            border-radius: 8px;
            width: 100%;
            font-weight: bold;
            cursor: pointer;
            transition: 0.3s;
        }
        .btn-add:hover { background: #795548; }
        .btn-disabled { background: #333; color: #666; cursor: not-allowed; width: 100%; padding: 12px; border-radius: 8px; border: none; }

        /* --- Footer --- */
        footer {
            background: #000;
            padding: 60px 8% 20px;
            border-top: 1px solid #222;
            margin-top: 50px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 40px;
            margin-bottom: 40px;
        }
        .footer-col h4 { color: var(--text-light); margin-bottom: 20px; font-size: 16px; }
        .footer-col p, .footer-col a { color: var(--text-dim); font-size: 14px; text-decoration: none; display: block; margin-bottom: 10px; }
        .footer-bottom { text-align: center; border-top: 1px solid #222; padding-top: 20px; font-size: 12px; color: #555; }
    </style>
</head>
<body>

<header>
    <div class="logo-section">
        <img src="/Simeon Cafe.jpg" width="45" alt="Simeon Logo" onerror="this.style.display='none'">
        <div class="brand-name">
            <h1>SIMEON CAFE</h1>
            <p>PREMIUM COFFEE SHOP</p>
            <span class="status-pill <%= storeOpen ? '' : 'closed' %>">
                <%= storeOpen ? 'OPEN NOW' : 'CLOSED' %>
            </span>
        </div>
    </div>
    <nav>
        <a href="/">HOME</a>
        <a href="#menu">MENU</a>
        <a href="#about">ABOUT</a>
        <div class="cart-btn" onclick="checkout()">
            <i class="fas fa-shopping-cart" style="color: var(--accent-gold);"></i>
            <span id="cart-count">0</span>
        </div>
    </nav>
</header>

<section class="hero">
    <h2>Welcome to <span>Simeon Cafe</span></h2>
    <p>Experience the finest handcrafted coffee and treats in Silago. From our signature frappes to our premium roasts, we brew every cup with passion.</p>
</section>

<div class="menu-container" id="menu">
    <div class="section-title">
        <h3>Discover Our Favorites</h3>
    </div>

    <div class="product-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
                <div class="product-card">
                    <img src="/images/<%= p.image %>" class="product-img" onerror="this.src='/images/default.jpg'">
                    <div class="product-name"><%= p.name %></div>
                    <div class="product-price">₱<%= p.price_1 || 0 %></div>
                    
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <input type="number" value="1" min="1" id="qty-<%= p.id %>" 
                               style="width: 50px; background: #222; color: white; border: 1px solid #444; padding: 10px; border-radius: 8px; text-align: center;">
                        
                        <button class="<%= storeOpen ? 'btn-add' : 'btn-disabled' %>"
                                data-id="<%= p.id %>"
                                data-name="<%= p.name %>"
                                data-price="<%= p.price_1 || 0 %>"
                                onclick="addToCart(this)"
                                <%= !storeOpen ? 'disabled' : '' %>>
                            <%= storeOpen ? 'ADD TO CART' : 'CLOSED' %>
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: var(--text-dim);">No items available in the menu currently.</p>
        <% } %>
    </div>
</div>

<footer>
    <div class="footer-grid">
        <div class="footer-col">
            <h4>SIMEON CAFE</h4>
            <p>Dedicated to serving premium coffee and handcrafted snacks. We bring the finest beans to Silago for an unparalleled coffee experience.</p>
            <a href="#"><i class="fab fa-facebook"></i> Follow us on Facebook</a>
        </div>
        <div class="footer-col">
            <h4>QUICK LINKS</h4>
            <a href="/">Home</a>
            <a href="#menu">Full Menu</a>
            <a onclick="checkout()">My Cart</a>
        </div>
        <div class="footer-col">
            <h4>GET IN TOUCH</h4>
            <p><i class="fas fa-map-marker-alt"></i> Poblacion District 1, Silago, Southern Leyte</p>
            <p><i class="fas fa-phone"></i> 09771053180</p>
            <p><i class="fas fa-envelope"></i> hersanofritz@gmail.com</p>
        </div>
        <div class="footer-col">
            <h4>OPENING HOURS</h4>
            <p>Mon - Sun: 8:00 AM - 10:00 PM</p>
            <span class="status-pill">OPEN NOW</span>
        </div>
    </div>
    <div class="footer-bottom">
        © 2023 Simeon Cafe. All Rights Reserved.<br>
        <a href="/login" style="margin-top: 10px; display: inline-block; color: #444;">STAFF LOGIN PORTAL</a>
    </div>
</footer>

<script>
    let cart = [];

    function addToCart(button) {
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');
        const price = parseFloat(button.getAttribute('data-price'));
        const qty = parseInt(document.getElementById('qty-' + id).value) || 1;

        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity += qty;
        } else {
            cart.push({ id, name, price, quantity: qty });
        }
        
        document.getElementById('cart-count').innerText = cart.reduce((sum, item) => sum + item.quantity, 0);
        alert(name + " added!");
    }

    async function checkout() {
        if (cart.length === 0) return alert("Your cart is empty!");
        const customerName = prompt("Enter your name:");
        if (!customerName) return;

        const orderData = {
            customer_name: customerName,
            items: cart.map(i => `${i.name} (x${i.quantity})`).join(', '),
            total_price: cart.reduce((sum, i) => sum + (i.price * i.quantity), 0)
        };

        const response = await fetch('/api/place-order', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(orderData)
        });

        if (response.ok) {
            alert("Order placed successfully!");
            cart = [];
            document.getElementById('cart-count').innerText = "0";
        }
    }
</script>

</body>
</html>