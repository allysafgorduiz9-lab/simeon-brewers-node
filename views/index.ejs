<!DOCTYPE html>
<html>
<head>
    <title>Simeon Brewers - Menu</title>
    <style>
        body { background: #F8F4F1; font-family: 'Segoe UI', sans-serif; margin: 0; padding: 20px; padding-bottom: 120px; }
        .header { text-align: center; padding: 40px; background: #2D1B14; color: white; border-radius: 0 0 30px 30px; margin: -20px -20px 40px -20px; }
        .menu-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 25px; max-width: 1200px; margin: 0 auto; }
        .product-card { background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center; padding-bottom: 20px; }
        .price-tag { color: #C6A664; font-weight: bold; font-size: 20px; margin: 10px 0; }
        .order-btn { background: #2D1B14; color: #C6A664; border: none; padding: 12px 25px; border-radius: 10px; font-weight: bold; cursor: pointer; width: 85%; }
        
        /* Floating Cart Bar */
        .cart-bar { position: fixed; bottom: 30px; left: 50%; transform: translateX(-50%); width: 90%; max-width: 500px; background: #2D1B14; color: white; padding: 15px 30px; border-radius: 50px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 10px 30px rgba(0,0,0,0.4); display: none; z-index: 1000; }
        .checkout-btn { background: #C6A664; color: #2D1B14; border: none; padding: 10px 25px; border-radius: 25px; font-weight: bold; cursor: pointer; }
        
        /* Modal Style */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.85); justify-content: center; align-items: center; z-index: 2000; }
        .modal-content { background: white; padding: 30px; border-radius: 20px; width: 90%; max-width: 400px; position: relative; }
        input { width: 100%; padding: 12px; margin: 10px 0; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; font-size: 16px; }
        .grayscale { filter: grayscale(1); opacity: 0.6; pointer-events: none; }
    </style>
</head>
<body>
    <div class="header">
        <h1 style="margin: 0; letter-spacing: 2px;">SIMEON BREWERS</h1>
        <p style="color: #C6A664; margin-top: 5px;">Excellence in Every Cup</p>
    </div>

    <div class="menu-grid <%= !storeOpen ? 'grayscale' : '' %>">
        <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
                <div class="product-card">
                    <img src="/images/<%= p.image %>" style="width: 100%; height: 220px; object-fit: cover;">
                    <div style="padding: 15px;">
                        <span style="font-size: 11px; color: #888; text-transform: uppercase;"><%= p.category %></span>
                        <h3 style="margin: 5px 0;"><%= p.name %></h3>
                        <div class="price-tag">₱<%= p.price_1 %></div>
                        
                        <button class="order-btn" 
                                data-name="<%= p.name %>" 
                                data-price="<%= p.price_1 %>"
                                onclick="addToCart(this)">
                            Add to Order
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="text-align: center; grid-column: 1/-1; color: #888; padding: 50px;">The menu is currently empty.</p>
        <% } %>
    </div>

    <div id="cartBar" class="cart-bar">
        <div>
            <span id="cartCount">0 Items</span> • <strong>₱<span id="cartTotal">0</span></strong>
        </div>
        <button class="checkout-btn" onclick="showCheckout()">Checkout</button>
    </div>

    <div id="checkoutModal" class="modal">
        <div class="modal-content">
            <h2 style="color: #2D1B14; margin-top: 0;">Order Summary</h2>
            <div id="orderList" style="max-height: 150px; overflow-y: auto; margin-bottom: 15px; border-bottom: 1px solid #eee; padding-bottom: 10px;"></div>
            <p style="font-weight: bold; text-align: right; font-size: 18px;">Total: ₱<span id="modalTotal">0</span></p>
            
            <form action="/place-order" method="POST">
                <input type="hidden" name="items" id="itemsInput">
                <input type="hidden" name="total" id="totalInput">
                <input type="text" name="customer_name" placeholder="Enter Your Name" required>
                <button type="submit" class="order-btn" style="width: 100%; margin-top: 10px;">Confirm & Send Order</button>
                <button type="button" onclick="closeCheckout()" style="background: none; border: none; color: #888; width: 100%; margin-top: 10px; cursor: pointer;">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        let cart = [];
        let total = 0;

        function addToCart(btn) {
            const name = btn.getAttribute('data-name');
            const price = Number(btn.getAttribute('data-price'));

            cart.push({ name, price });
            total += price;
            
            updateCartUI();
        }

        function updateCartUI() {
            const cartBar = document.getElementById('cartBar');
            if (cart.length > 0) {
                cartBar.style.display = 'flex';
                document.getElementById('cartCount').innerText = cart.length + (cart.length === 1 ? " Item" : " Items");
                document.getElementById('cartTotal').innerText = total.toLocaleString();
            }
        }

        function showCheckout() {
            const orderList = document.getElementById('orderList');
            const itemsInput = document.getElementById('itemsInput');
            
            // List items for the user to see
            orderList.innerHTML = cart.map(item => `
                <div style="display:flex; justify-content:space-between; margin-bottom:5px; font-size:14px;">
                    <span>${item.name}</span>
                    <span>₱${item.price}</span>
                </div>
            `).join('');
            
            // Prepare the comma-separated string for your database
            itemsInput.value = cart.map(item => item.name).join(", ");
            document.getElementById('totalInput').value = total;
            document.getElementById('modalTotal').innerText = total.toLocaleString();
            
            document.getElementById('checkoutModal').style.display = 'flex';
        }

        function closeCheckout() {
            document.getElementById('checkoutModal').style.display = 'none';
        }
    </script>
</body>
</html>