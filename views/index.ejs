<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simeon Cafe | Premium Coffee Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root { --bg-dark: #0f0f0f; --card-dark: #1a1a1a; --accent-gold: #C6A664; --accent-hover: #e0c285; --text-light: #ffffff; --text-dim: #b3b3b3; --status-green: #27ae60; --danger: #e74c3c; --fb-blue: #1877F2; }
        * { box-sizing: border-box; transition: all 0.3s ease; }
        body { font-family: 'Poppins', sans-serif; margin: 0; background-color: var(--bg-dark); color: var(--text-light); scroll-behavior: smooth; }
        header { background-color: rgba(15, 15, 15, 0.98); padding: 15px 8%; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; border-bottom: 1px solid rgba(255,255,255,0.05); backdrop-filter: blur(10px); }
        .logo-section { display: flex; align-items: center; }
        .logo-section img { border-radius: 8px; margin-right: 15px; border: 1px solid var(--accent-gold); }
        .brand-name h1 { font-family: 'Playfair Display', serif; font-size: 20px; margin: 0; letter-spacing: 1px; }
        .brand-name p { font-size: 9px; margin: 0; color: var(--accent-gold); font-weight: 600; text-transform: uppercase; }
        .status-pill { background: var(--status-green); color: white; padding: 3px 10px; border-radius: 4px; font-size: 9px; font-weight: bold; margin-top: 5px; display: inline-block; }
        .status-pill.closed { background: var(--danger); }
        nav { display: flex; align-items: center; gap: 25px; }
        nav a { color: var(--text-light); text-decoration: none; font-size: 13px; font-weight: 600; }
        nav a:hover { color: var(--accent-gold); }
        .nav-actions { display: flex; align-items: center; gap: 12px; }
        .login-btn, .cart-btn { background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.1); padding: 8px 14px; border-radius: 10px; display: flex; align-items: center; gap: 8px; cursor: pointer; color: var(--text-light); text-decoration: none; }
        .login-btn:hover, .cart-btn:hover { border-color: var(--accent-gold); background: rgba(198, 166, 100, 0.05); }
        .hero { height: 65vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.9)), url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&q=80&w=1920'); background-size: cover; background-position: center; padding: 0 10%; }
        .hero h2 { font-family: 'Playfair Display', serif; font-size: clamp(32px, 5vw, 52px); margin-bottom: 15px; }
        .hero h2 span { color: var(--accent-gold); }
        .hero p { color: var(--text-dim); line-height: 1.8; max-width: 650px; font-weight: 300; }
        .store-closed-banner { background: var(--danger); color: white; text-align: center; padding: 15px; font-weight: 600; font-size: 16px; }
        .menu-container { padding: 80px 8%; }
        .search-container { max-width: 500px; margin: 0 auto 40px; position: relative; }
        .search-bar { width: 100%; padding: 16px 20px; padding-left: 50px; background: var(--card-dark); border: 1px solid rgba(255,255,255,0.1); border-radius: 14px; color: var(--text-light); font-size: 16px; font-family: inherit; }
        .search-bar:focus { outline: none; border-color: var(--accent-gold); }
        .search-icon { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--text-dim); }
        .section-title { text-align: center; margin-bottom: 50px; }
        .section-title h3 { color: var(--accent-gold); letter-spacing: 3px; font-size: 14px; text-transform: uppercase; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 30px; }
        .product-card { background: var(--card-dark); border: 1px solid rgba(255,255,255,0.05); border-radius: 20px; padding: 25px; text-align: center; }
        .product-card:hover { transform: translateY(-8px); border-color: var(--accent-gold); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }
        .product-card.unavailable { opacity: 0.5; }
        .product-img { width: 100%; height: 220px; object-fit: cover; border-radius: 15px; margin-bottom: 20px; }
        .product-name { font-family: 'Playfair Display', serif; font-size: 22px; margin: 10px 0; }
        .product-price { color: var(--accent-gold); font-size: 18px; font-weight: 600; margin-bottom: 10px; }
        .availability-badge { display: inline-block; padding: 4px 10px; border-radius: 8px; font-size: 11px; font-weight: 600; margin-bottom: 15px; }
        .badge-available { background: rgba(39,174,96,0.2); color: #27ae60; }
        .badge-unavailable { background: rgba(231,76,60,0.2); color: #e74c3c; }
        .btn-add { background: var(--accent-gold); color: #000; border: none; padding: 14px; border-radius: 12px; width: 100%; font-weight: 600; cursor: pointer; }
        .btn-add:hover { background: var(--accent-hover); transform: scale(1.02); }
        .btn-disabled { background: #2a2a2a; color: #555; cursor: not-allowed; width: 100%; padding: 14px; border-radius: 12px; border: none; }
        .qty-input { width: 60px; background: #252525; color: white; border: 1px solid #444; padding: 12px; border-radius: 12px; text-align: center; }
        .pagination { display: flex; justify-content: center; align-items: center; gap: 20px; margin-top: 50px; }
        .nav-btn { padding: 10px 20px; border: 1px solid rgba(255,255,255,0.1); border-radius: 8px; background: rgba(255,255,255,0.03); color: var(--accent-gold); text-decoration: none; font-weight: 600; font-size: 14px; display: flex; align-items: center; gap: 8px; }
        .nav-btn:hover:not(.disabled) { border-color: var(--accent-gold); background: rgba(198, 166, 100, 0.1); transform: translateY(-2px); }
        .nav-btn.disabled { pointer-events: none; opacity: 0.3; color: var(--text-dim); }
        footer { background: #000; padding: 80px 8% 30px; border-top: 1px solid rgba(255,255,255,0.05); margin-top: 80px; }
        .footer-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 50px; margin-bottom: 50px; }
        .footer-col h4 { color: var(--accent-gold); margin-bottom: 25px; font-size: 16px; font-family: 'Playfair Display', serif; }
        .footer-col p, .footer-col a { color: var(--text-dim); font-size: 14px; text-decoration: none; line-height: 1.8; display: block; }
        .footer-col a:hover { color: var(--accent-gold); }
        .footer-bottom { text-align: center; border-top: 1px solid #1a1a1a; padding-top: 30px; font-size: 11px; color: #444; letter-spacing: 1px; }
        .fb-btn { background: var(--fb-blue); color: white; padding: 10px 20px; border-radius: 8px; display: inline-flex; align-items: center; gap: 10px; font-weight: 600; margin-top: 15px; text-decoration: none; }
    </style>
</head>
<body>
<header>
    <div class="logo-section">
        <img src="/images/Simeon Cafe.jpg" width="45" alt="Simeon Logo" onerror="this.style.display='none'">
        <div class="brand-name">
            <h1>SIMEON CAFE</h1>
            <p>Premium Coffee Shop</p>
            <span class="status-pill <%= storeStatus === 'CLOSED' ? 'closed' : '' %>"><%= storeStatus %></span>
        </div>
    </div>
    <nav>
        <a href="/">HOME</a>
        <a href="#about">ABOUT</a>
        <a href="#menu">MENU</a>
        <div class="nav-actions">
            <a href="/login" class="login-btn"><i class="fas fa-user-circle"></i></a>
            <div class="cart-btn" onclick="checkout()">
                <i class="fas fa-shopping-cart" style="color: var(--accent-gold);"></i>
                <span id="cart-count">0</span>
            </div>
        </div>
    </nav>
</header>

<section class="hero">
    <h2>Welcome to <span>Simeon Cafe</span></h2>
    <p>Experience the finest handcrafted coffee and treats in Silago.</p>
</section>

<% if (storeStatus === 'CLOSED') { %>
<div class="store-closed-banner">
    <i class="fas fa-exclamation-circle"></i> STORE IS CURRENTLY CLOSED - Online ordering is not available
</div>
<% } %>

<div class="menu-container" id="menu">
    <div class="section-title"><h3>Discover Our Favorites</h3></div>
    <div class="search-container">
        <i class="fas fa-search search-icon"></i>
        <input type="text" class="search-bar" id="searchInput" placeholder="Search menu..." onkeyup="searchProducts()">
    </div>
    <div class="product-grid" id="productGrid">
        <% 
        var itemsPerPage = 8;
        var currentPage = page || 1;
        var start = (currentPage - 1) * itemsPerPage;
        var end = start + itemsPerPage;
        var paginatedProducts = products.slice(start, end);
        var totalPages = Math.ceil(products.length / itemsPerPage);
        %>
        <% paginatedProducts.forEach(function(p) { %>
        <div class="product-card <%= p.active == 0 ? 'unavailable' : '' %>" data-name="<%= p.name.toLowerCase() %>">
            <img src="/images/<%= p.image %>" class="product-img" onerror="this.src='https://images.unsplash.com/photo-1509042239860-f550ce710b93?q=80&w=400'">
            <div class="product-name"><%= p.name %></div>
            <div class="product-price">₱<%= parseFloat(p.price_1).toFixed(2) %></div>
            <span class="availability-badge <%= p.active == 1 ? 'badge-available' : 'badge-unavailable' %>">
                <%= p.active == 1 ? 'Available' : 'Unavailable' %>
            </span>
            <div style="display: flex; gap: 10px; align-items: center;">
                <input type="number" value="1" min="1" id="qty-<%= p.id %>" class="qty-input" <%= (storeStatus === 'CLOSED' || p.active == 0) ? 'disabled' : '' %>>
                <button class="<%= (storeStatus === 'OPEN' && p.active == 1) ? 'btn-add' : 'btn-disabled' %>"
                    data-id="<%= p.id %>"
                    data-name="<%= p.name %>"
                    data-price="<%= p.price_1 %>"
                    onclick="addToCart(this)"
                    <%= (storeStatus === 'CLOSED' || p.active == 0) ? 'disabled' : '' %>>
                    <%= storeStatus === 'CLOSED' ? 'CLOSED' : (p.active == 1 ? 'ADD TO CART' : 'Unavailable') %>
                </button>
            </div>
        </div>
        <% }); %>
    </div>
    <% if (totalPages > 1) { %>
    <div class="pagination">
        <a href="/?page=<%= currentPage - 1 %>" class="nav-btn <%= currentPage <= 1 ? 'disabled' : '' %>">
            <i class="fas fa-arrow-left"></i> Previous
        </a>
        <span style="font-size: 14px; color: var(--accent-gold); font-weight: bold;">
            Page <%= currentPage %> of <%= totalPages %>
        </span>
        <a href="/?page=<%= currentPage + 1 %>" class="nav-btn <%= currentPage >= totalPages ? 'disabled' : '' %>">
            Next <i class="fas fa-arrow-right"></i>
        </a>
    </div>
    <% } %>
</div>

<footer id="about">
    <div class="footer-grid">
        <div class="footer-col">
            <h4>ABOUT</h4>
            <p>Simeon Cafe brings the finest beans to Silago for an unparalleled coffee experience. We are committed to quality, ambiance, and exceptional service.</p>
            <a href="https://www.facebook.com/profile.php?id=100092630560572" target="_blank" class="fb-btn"><i class="fab fa-facebook-f"></i> Like us on Facebook</a>
        </div>
        <div class="footer-col">
            <h4>QUICK LINKS</h4>
            <a href="/">Home</a>
            <a href="#about">About</a>
            <a href="#menu">Menu</a>
            <a href="/login">Staff Login</a>
        </div>
        <div class="footer-col">
            <h4>CONTACT</h4>
            <p><i class="fas fa-map-marker-alt" style="color: var(--accent-gold);"></i> Poblacion District 1, Silago</p>
            <p><i class="fas fa-phone" style="color: var(--accent-gold);"></i> 0977 105 3180</p>
            <p><i class="fas fa-clock" style="color: var(--accent-gold);"></i> Mon-Sun: 8AM - 10PM</p>
        </div>
    </div>
    <div class="footer-bottom">&copy; 2026 SIMEON CAFE. ALL RIGHTS RESERVED.</div>
</footer>

<script>
var cart = JSON.parse(localStorage.getItem('simeon_cart')) || [];
updateCartCount();

function addToCart(button) {
    var id = button.getAttribute('data-id');
    var name = button.getAttribute('data-name');
    var price = parseFloat(button.getAttribute('data-price'));
    var qty = parseInt(document.getElementById('qty-' + id).value) || 1;

    var existing = cart.find(function(item) { return item.id === id; });
    if (existing) {
        existing.quantity += qty;
    } else {
        cart.push({ id: id, name: name, price: price, quantity: qty });
    }
    
    localStorage.setItem('simeon_cart', JSON.stringify(cart));
    updateCartCount();
    alert(name + " added to cart!");
}

function updateCartCount() {
    var count = cart.reduce(function(sum, item) { return sum + item.quantity; }, 0);
    document.getElementById('cart-count').textContent = count;
}

function checkout() {
    if (cart.length === 0) {
        alert("Your cart is empty!");
        return;
    }
    var total = cart.reduce(function(sum, item) { return sum + (item.price * item.quantity); }, 0);
    var confirmOrder = confirm("Total: ₱" + total.toFixed(2) + "\n\nProceed to checkout?");
    if (confirmOrder) {
        window.location.href = '/checkout';
    }
}

function searchProducts() {
    var input = document.getElementById('searchInput').value.toLowerCase();
    var cards = document.querySelectorAll('.product-card');
    cards.forEach(function(card) {
        var name = card.getAttribute('data-name') || "";
        card.style.display = name.includes(input) ? 'block' : 'none';
    });
}

function checkStoreStatus() {
    var status = "<%= storeStatus %>";
    if (status === 'CLOSED') {
        var btns = document.querySelectorAll('.btn-add, .btn-disabled');
        var inputs = document.querySelectorAll('.qty-input');
        btns.forEach(function(btn) {
            btn.disabled = true;
            btn.textContent = 'CLOSED';
        });
        inputs.forEach(function(input) { input.disabled = true; });
    }
}

window.onload = checkStoreStatus;
</script>
</body>
</html>