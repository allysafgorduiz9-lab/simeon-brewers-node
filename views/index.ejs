<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simeon Cafe | Premium Coffee Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0f0f0f;
            --card-dark: #1a1a1a;
            --accent-gold: #C6A664;
            --accent-hover: #e0c285;
            --text-light: #ffffff;
            --text-dim: #b3b3b3;
            --status-green: #27ae60;
            --danger: #e74c3c;
        }

        * { box-sizing: border-box; transition: all 0.3s ease; }

        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            background-color: var(--bg-dark);
            color: var(--text-light);
            scroll-behavior: smooth;
        }

        /* --- Header --- */
        header {
            background-color: rgba(15, 15, 15, 0.98);
            padding: 15px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
        }

        .logo-section { display: flex; align-items: center; }
        .logo-section img { border-radius: 8px; margin-right: 15px; border: 1px solid var(--accent-gold); }
        .brand-name h1 { font-family: 'Playfair Display', serif; font-size: 20px; margin: 0; letter-spacing: 1px; }
        .brand-name p { font-size: 9px; margin: 0; color: var(--accent-gold); font-weight: 600; text-transform: uppercase; }

        .status-pill {
            background: var(--status-green);
            color: white;
            padding: 3px 10px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: bold;
            margin-top: 5px;
            display: inline-block;
        }
        .status-pill.closed { background: var(--danger); }

        nav { display: flex; align-items: center; gap: 25px; }
        nav a { color: var(--text-light); text-decoration: none; font-size: 13px; font-weight: 600; }
        
        .nav-actions { display: flex; align-items: center; gap: 12px; }

        .login-btn, .cart-btn {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 8px 14px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: var(--text-light);
            text-decoration: none;
        }

        .cart-btn #cart-count {
            background: var(--accent-gold);
            color: #000;
            font-size: 10px;
            font-weight: bold;
            padding: 2px 6px;
            border-radius: 50%;
        }

        /* --- Menu Section --- */
        .menu-container { padding: 60px 8%; }
        .section-title { text-align: center; margin-bottom: 50px; }
        .section-title h3 { color: var(--accent-gold); letter-spacing: 3px; font-size: 14px; text-transform: uppercase; }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
        }

        .product-card {
            background: var(--card-dark);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
        }

        .product-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 15px;
            margin-bottom: 20px;
        }

        .product-name { font-family: 'Playfair Display', serif; font-size: 22px; margin: 10px 0; }
        .product-price { color: var(--accent-gold); font-size: 18px; font-weight: 600; margin-bottom: 20px; }

        .btn-add {
            background: var(--accent-gold);
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 12px;
            width: 100%;
            font-weight: 600;
            cursor: pointer;
        }

        .btn-disabled {
            background: #2a2a2a;
            color: #555;
            cursor: not-allowed;
            width: 100%;
            padding: 14px;
            border-radius: 12px;
            border: none;
        }

        .qty-input {
            width: 60px;
            background: #252525;
            color: white;
            border: 1px solid #444;
            padding: 12px;
            border-radius: 12px;
            text-align: center;
        }
    </style>
</head>
<body>

<header>
    <div class="logo-section">
        <img src="/Simeon Cafe.jpg" width="45" alt="Simeon Logo" onerror="this.style.display='none'">
        <div class="brand-name">
            <h1>SIMEON CAFE</h1>
            <p>Premium Coffee Shop</p>
            <span class="status-pill <%= storeOpen ? '' : 'closed' %>">
                <%= storeOpen ? 'OPEN NOW' : 'CLOSED' %>
            </span>
        </div>
    </div>
    <nav>
        <a href="/">HOME</a>
        <a href="#menu">MENU</a>
        <div class="nav-actions">
            <a href="/login" class="login-btn" title="Staff Login">
                <i class="fas fa-user-circle"></i>
            </a>
            <div class="cart-btn" onclick="checkout()">
                <i class="fas fa-shopping-cart" style="color: var(--accent-gold);"></i>
                <span id="cart-count">0</span>
            </div>
        </div>
    </nav>
</header>

<div class="menu-container" id="menu">
    <div class="section-title">
        <h3>Our Menu</h3>
    </div>

    <div class="product-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
                <div class="product-card">
                    <img src="/images/<%= p.image %>" class="product-img" onerror="this.src='https://images.unsplash.com/photo-1509042239860-f550ce710b93?q=80&w=400'">
                    <div class="product-name"><%= p.name %></div>
                    
                    <!-- Fixed Price Display -->
                    <div class="product-price">
                        ₱<%= (parseFloat(p.price_1) || 0).toFixed(2) %>
                    </div>
                    
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <input type="number" value="1" min="1" id="qty-<%= p.id %>" class="qty-input">
                        
                        <button class="<%= storeOpen ? 'btn-add' : 'btn-disabled' %>"
                                data-id="<%= p.id %>"
                                data-name="<%= p.name %>"
                                data-price="<%= p.price_1 %>"
                                onclick="addToCart(this)"
                                <%= !storeOpen ? 'disabled' : '' %>>
                            <%= storeOpen ? 'ADD TO CART' : 'CLOSED' %>
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: var(--text-dim);">No items available.</p>
        <% } %>
    </div>
</div>

<script>
    let cart = [];

    function addToCart(button) {
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');
        const price = parseFloat(button.getAttribute('data-price')) || 0;
        const qtyInput = document.getElementById('qty-' + id);
        const qty = parseInt(qtyInput.value) || 1;

        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity += qty;
        } else {
            cart.push({ id, name, price, quantity: qty });
        }
        
        updateCartCount();
        alert(name + " added to cart!");
    }

    function updateCartCount() {
        const total = cart.reduce((sum, item) => sum + item.quantity, 0);
        document.getElementById('cart-count').innerText = total;
    }

    function checkout() {
        // You can pass the cart data via localStorage or a form post
        localStorage.setItem('simeon_cart', JSON.stringify(cart));
        window.location.href = '/checkout';
    }
</script>

</body>
</html>