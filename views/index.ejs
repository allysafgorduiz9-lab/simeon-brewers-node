<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simeon Cafe | Premium Coffee Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&family=Playfair+Display:wght@700&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-dark: #0f0f0f;
            --card-dark: #1a1a1a;
            --accent-gold: #C6A664;
            --accent-hover: #e0c285;
            --text-light: #ffffff;
            --text-dim: #b3b3b3;
            --primary-brown: #5D4037;
            --status-green: #27ae60;
            --danger: #e74c3c;
        }

        * { box-sizing: border-box; transition: all 0.3s ease; }

        body {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            background-color: var(--bg-dark);
            color: var(--text-light);
            scroll-behavior: smooth;
        }

        /* --- Header --- */
        header {
            background-color: rgba(15, 15, 15, 0.98);
            padding: 15px 8%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            backdrop-filter: blur(10px);
        }

        .logo-section { display: flex; align-items: center; }
        .logo-section img { border-radius: 8px; margin-right: 15px; border: 1px solid var(--accent-gold); }
        .brand-name h1 { font-family: 'Playfair Display', serif; font-size: 20px; margin: 0; letter-spacing: 1px; color: var(--text-light); }
        .brand-name p { font-size: 9px; margin: 0; color: var(--accent-gold); font-weight: 600; text-transform: uppercase; }

        .status-pill {
            background: var(--status-green);
            color: white;
            padding: 3px 10px;
            border-radius: 4px;
            font-size: 9px;
            font-weight: bold;
            margin-top: 5px;
            display: inline-block;
        }
        .status-pill.closed { background: var(--danger); }

        nav { display: flex; align-items: center; gap: 25px; }
        nav a { color: var(--text-light); text-decoration: none; font-size: 13px; font-weight: 600; }
        nav a:hover { color: var(--accent-gold); }

        .nav-actions { display: flex; align-items: center; gap: 12px; }

        .login-btn, .cart-btn {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.1);
            padding: 8px 14px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: var(--text-light);
            text-decoration: none;
        }

        .login-btn:hover, .cart-btn:hover {
            border-color: var(--accent-gold);
            background: rgba(198, 166, 100, 0.05);
        }

        /* --- Hero Section --- */
        .hero {
            height: 65vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            background: linear-gradient(rgba(0,0,0,0.7), rgba(0,0,0,0.9)), url('https://images.unsplash.com/photo-1495474472287-4d71bcdd2085?auto=format&fit=crop&q=80&w=1920'); 
            background-size: cover;
            background-position: center;
            padding: 0 10%;
        }

        /* --- Menu Section --- */
        .menu-container { padding: 80px 8%; }
        .section-title { text-align: center; margin-bottom: 50px; }
        .section-title h3 { color: var(--accent-gold); letter-spacing: 3px; font-size: 14px; text-transform: uppercase; }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
        }

        .product-card {
            background: var(--card-dark);
            border: 1px solid rgba(255,255,255,0.05);
            border-radius: 20px;
            padding: 25px;
            text-align: center;
            position: relative;
        }
        .product-card:hover { transform: translateY(-8px); border-color: var(--accent-gold); box-shadow: 0 10px 30px rgba(0,0,0,0.5); }

        .product-img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            border-radius: 15px;
            margin-bottom: 20px;
        }

        .product-name { font-family: 'Playfair Display', serif; font-size: 22px; margin: 10px 0; color: var(--text-light); }
        .product-price { color: var(--accent-gold); font-size: 18px; font-weight: 600; margin-bottom: 20px; }

        .btn-add {
            background: var(--accent-gold);
            color: #000;
            border: none;
            padding: 14px;
            border-radius: 12px;
            width: 100%;
            font-weight: 600;
            cursor: pointer;
        }
        .btn-add:hover { background: var(--accent-hover); transform: scale(1.02); }
        
        .btn-disabled { background: #2a2a2a; color: #555; cursor: not-allowed; width: 100%; padding: 14px; border-radius: 12px; border: none; }

        .qty-input {
            width: 60px;
            background: #252525;
            color: white;
            border: 1px solid #444;
            padding: 12px;
            border-radius: 12px;
            text-align: center;
            font-family: inherit;
        }

        .view-more-btn {
            background: transparent;
            border: 1px solid var(--accent-gold);
            color: var(--accent-gold);
            padding: 12px 35px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            margin-top: 40px;
            transition: 0.3s;
        }
        .view-more-btn:hover { background: var(--accent-gold); color: #000; }

        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        footer {
            background: #000;
            padding: 80px 8% 30px;
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: 80px;
        }
        .footer-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 50px;
            margin-bottom: 50px;
        }
        .footer-col h4 { color: var(--accent-gold); margin-bottom: 25px; font-size: 16px; letter-spacing: 1px; }
        .footer-col p, .footer-col a { color: var(--text-dim); font-size: 14px; text-decoration: none; line-height: 1.8; margin-bottom: 12px; }
        .footer-bottom { text-align: center; border-top: 1px solid #1a1a1a; padding-top: 30px; font-size: 11px; color: #444; }
    </style>
</head>
<body>

<header>
    <div class="logo-section">
        <img src="/Simeon Cafe.jpg" width="45" alt="Simeon Logo" onerror="this.style.display='none'">
        <div class="brand-name">
            <h1>SIMEON CAFE</h1>
            <p>Premium Coffee Shop</p>
            <span class="status-pill <%= storeOpen ? '' : 'closed' %>">
                <%= storeOpen ? 'OPEN NOW' : 'CLOSED' %>
            </span>
        </div>
    </div>
    <nav>
        <a href="/">HOME</a>
        <a href="#menu">MENU</a>
        <a href="#about">ABOUT</a>
        
        <div class="nav-actions">
            <a href="/login" class="login-btn" title="Staff Login">
                <i class="fas fa-user-circle"></i>
            </a>
            <div class="cart-btn" onclick="checkout()">
                <i class="fas fa-shopping-cart" style="color: var(--accent-gold);"></i>
                <span id="cart-count">0</span>
            </div>
        </div>
    </nav>
</header>

<section class="hero">
    <h2 style="font-family: 'Playfair Display', serif; font-size: 48px;">Welcome to <span style="color: var(--accent-gold);">Simeon Cafe</span></h2>
    <p style="color: var(--text-dim); max-width: 600px;">Experience handcrafted coffee brewed with heart and passion in Silago.</p>
</section>

<div class="menu-container" id="menu">
    <div class="section-title">
        <h3>Discover Our Favorites</h3>
    </div>

    <div class="product-grid" id="productGrid">
        <% if (products && products.length > 0) { %>
            <% products.forEach((p, index) => { %>
                <div class="product-card product-item" 
                     style="<%= index >= 10 ? 'display: none;' : '' %>">
                    <img src="/images/<%= p.image %>" class="product-img" onerror="this.src='https://images.unsplash.com/photo-1509042239860-f550ce710b93?q=80&w=400'">
                    <div class="product-name"><%= p.name %></div>
                    
                    <!-- CORRECTED PRICE DISPLAY -->
                    <div class="product-price">₱<%= (parseFloat(p.price_1) || 0).toFixed(2) %></div>
                    
                    <div style="display: flex; gap: 10px; align-items: center;">
                        <input type="number" value="1" min="1" id="qty-<%= p.id %>" class="qty-input">
                        
                        <button class="<%= storeOpen ? 'btn-add' : 'btn-disabled' %>"
                                data-id="<%= p.id %>"
                                data-name="<%= p.name %>"
                                data-price="<%= p.price_1 %>"
                                onclick="addToCart(this)"
                                <%= !storeOpen ? 'disabled' : '' %>>
                            <%= storeOpen ? 'ADD TO CART' : 'CLOSED' %>
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: var(--text-dim);">No items available in the menu currently.</p>
        <% } %>
    </div>

    <% if (products && products.length > 10) { %>
        <div style="text-align: center;">
            <button class="view-more-btn" id="loadMoreBtn" onclick="showMoreProducts()">VIEW ALL PRODUCTS</button>
        </div>
    <% } %>
</div>

<footer>
    <div class="footer-grid">
        <div class="footer-col">
            <h4>OUR STORY</h4>
            <p>Bringing the finest beans to Silago for an unparalleled coffee experience.</p>
        </div>
        <div class="footer-col">
            <h4>CONTACT</h4>
            <p>Poblacion District 1, Silago, Southern Leyte</p>
            <p>0977 105 3180</p>
        </div>
    </div>
    <div class="footer-bottom">
        &copy; 2026 SIMEON CAFE. ALL RIGHTS RESERVED.
    </div>
</footer>

<script>
    let cart = [];

    // Function to handle "Load More" logic
    function showMoreProducts() {
        const items = document.querySelectorAll('.product-item');
        items.forEach(item => {
            item.style.display = 'block';
            item.style.animation = 'fadeInUp 0.5s ease forwards';
        });
        document.getElementById('loadMoreBtn').style.display = 'none';
    }

    function addToCart(button) {
        const id = button.getAttribute('data-id');
        const name = button.getAttribute('data-name');
        const price = parseFloat(button.getAttribute('data-price')) || 0;
        const qty = parseInt(document.getElementById('qty-' + id).value) || 1;

        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity += qty;
        } else {
            cart.push({ id, name, price, quantity: qty });
        }
        
        updateCartCount();
        alert(name + " added to cart!");
    }

    function updateCartCount() {
        const total = cart.reduce((sum, item) => sum + item.quantity, 0);
        document.getElementById('cart-count').innerText = total;
    }

    function checkout() {
        window.location.href = 'checkout.php';
    }
</script>

</body>
</html>