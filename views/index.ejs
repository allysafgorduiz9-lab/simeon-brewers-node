<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simeon Cafe | Premium Coffee Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --primary-dark: #2D1B14; --accent-gold: #C6A664; --bg-cream: #F8F4F1; }
        body { font-family: 'Segoe UI', sans-serif; margin: 0; background-color: var(--bg-cream); }
        header { background-color: #1a1a1a; padding: 15px 50px; display: flex; justify-content: space-between; align-items: center; color: white; position: sticky; top: 0; z-index: 1000; }
        .status-badge { padding: 5px 12px; border-radius: 20px; font-size: 12px; font-weight: bold; }
        .open { background-color: #27ae60; color: white; }
        .closed { background-color: #e74c3c; color: white; }
        .container { display: flex; padding: 40px 50px; gap: 30px; max-width: 1400px; margin: auto; }
        .sidebar { width: 250px; background: white; border-radius: 20px; padding: 30px 20px; box-shadow: 0 4px 20px rgba(0,0,0,0.05); height: fit-content; }
        .category-list { list-style: none; padding: 0; }
        .category-list a { display: block; padding: 12px 15px; text-decoration: none; color: #666; font-weight: 600; font-size: 13px; border-radius: 10px; text-transform: uppercase; }
        .product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(350px, 1fr)); gap: 25px; }
        .product-card { background: white; border-radius: 20px; padding: 20px; display: flex; gap: 20px; box-shadow: 0 5px 15px rgba(0,0,0,0.02); }
        .product-img { width: 110px; height: 110px; border-radius: 15px; object-fit: cover; }
        .btn-add { background: #5D4037; color: white; border: none; padding: 10px; border-radius: 8px; font-weight: bold; cursor: pointer; flex: 1; }
        .btn-disabled { background: #e0e0e0; color: #999; border: none; padding: 10px; border-radius: 8px; font-weight: bold; cursor: not-allowed; flex: 1; }
    </style>
</head>
<body>

<header>
    <div style="display: flex; align-items: center; gap: 15px;">
        <img src="/Simeon Cafe.jpg" width="45" style="border-radius: 5px;">
        <div style="line-height: 1.2;">
            <h1 style="margin: 0; font-size: 18px;">SIMEON CAFE</h1>
            <p style="margin: 0; font-size: 10px; color: var(--accent-gold);">PREMIUM COFFEE SHOP</p>
        </div>
        <span class="status-badge <%= storeOpen ? 'open' : 'closed' %>"><%= storeOpen ? 'Open Now' : 'Closed' %></span>
    </div>
    <nav><a href="/" style="color:white; text-decoration:none;">HOME</a></nav>
</header>

<div class="container">
    <aside class="sidebar">
        <h3 style="border-left: 4px solid var(--accent-gold); padding-left: 10px;">Categories</h3>
        <ul class="category-list">
            <li><a href="/" style="background: var(--bg-cream); color: black;">ALL ITEMS</a></li>
            <% let uniqueCats = [...new Set(products.map(p => p.category))]; uniqueCats.forEach(cat => { %>
                <li><a href="#"><%= cat %></a></li>
            <% }); %>
        </ul>
    </aside>

    <main style="flex: 1;">
        <h2 style="color: #8D6E63; text-transform: uppercase;">Menu Items</h2>
        <div class="product-grid">
            <% products.forEach(p => { %>
                <div class="product-card">
                    <img src="/images/<%= p.image %>" class="product-img" onerror="this.src='/images/default.jpg'">
                    <div style="flex:1; display:flex; flex-direction:column; justify-content:space-between;">
                        <div>
                            <h4 style="margin:0;"><%= p.name %></h4>
                            <p style="font-size:12px; color:#aaa; margin:5px 0;">Handcrafted signature drink.</p>
                        </div>
                        <div style="font-weight:bold; color:#8D6E63;">₱<%= p.price_1 %></div>
                        <div style="display:flex; gap:10px; margin-top:10px;">
                            <input type="number" value="1" min="1" style="width:40px;" class="qty-input" <%= !storeOpen ? 'disabled' : '' %>>
                            <button class="<%= storeOpen ? 'btn-add' : 'btn-disabled' %>" <%= !storeOpen ? 'disabled' : '' %>><%= storeOpen ? 'Add to Cart' : 'Closed' %></button>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </main>
</div>

<script>
    setInterval(() => {
        fetch('/api/status').then(res => res.json()).then(data => {
            const badge = document.querySelector('.status-badge');
            badge.innerText = data.storeOpen ? 'Open Now' : 'Closed';
            badge.className = `status-badge ${data.storeOpen ? 'open' : 'closed'}`;
            document.querySelectorAll('.product-card button').forEach(btn => {
                btn.innerText = data.storeOpen ? 'Add to Cart' : 'Closed';
                btn.className = data.storeOpen ? 'btn-add' : 'btn-disabled';
                btn.disabled = !data.storeOpen;
            });
            document.querySelectorAll('.qty-input').forEach(i => i.disabled = !data.storeOpen);
        });
    }, 5000);
</script>
</body>
</html>