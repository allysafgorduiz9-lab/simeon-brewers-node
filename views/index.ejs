<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simeon Cafe | Premium Coffee Shop</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        :root { --primary-dark: #1a1a1a; --accent-gold: #C6A664; --bg-cream: #F8F4F1; }
        body { font-family: 'Segoe UI', sans-serif; margin: 0; background-color: var(--bg-cream); scroll-behavior: smooth; }
        header { background-color: var(--primary-dark); padding: 15px 8%; display: flex; justify-content: space-between; align-items: center; color: white; position: sticky; top: 0; z-index: 1000; }
        .status-badge { padding: 4px 12px; border-radius: 20px; font-size: 11px; font-weight: bold; text-transform: uppercase; margin-left: 10px; }
        .open { background-color: #27ae60; } .closed { background-color: #e74c3c; }
        nav a { color: white; text-decoration: none; margin-left: 25px; font-size: 13px; font-weight: 600; cursor: pointer; }
        .hero { background: #111; height: 30vh; display: flex; flex-direction: column; justify-content: center; align-items: center; color: white; text-align: center; }
        .main-content { display: flex; padding: 50px 8%; gap: 40px; }
        .sidebar { width: 200px; background: white; border-radius: 15px; padding: 20px; height: fit-content; }
        .product-grid { flex: 1; display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; }
        .product-card { background: white; border-radius: 15px; padding: 20px; box-shadow: 0 4px 10px rgba(0,0,0,0.05); text-align: center; }
        .product-img { width: 100%; height: 150px; border-radius: 10px; object-fit: cover; }
        .btn-add { background: #5D4037; color: white; border: none; padding: 10px; border-radius: 5px; cursor: pointer; width: 100%; font-weight: bold; }
        .btn-disabled { background: #ccc; color: #666; cursor: not-allowed; padding: 10px; border-radius: 5px; width: 100%; border: none; }
    </style>
</head>
<body>

<header>
    <div style="display: flex; align-items: center;">
        <img src="/Simeon Cafe.jpg" width="40" style="border-radius: 5px;" onerror="this.style.display='none'">
        <h1 style="margin: 0 0 0 10px; font-size: 18px;">SIMEON CAFE</h1>
        <span class="status-badge <%= storeOpen ? 'open' : 'closed' %>"><%= storeOpen ? 'Open' : 'Closed' %></span>
    </div>
    <nav>
        <a href="/">HOME</a>
        <a onclick="checkout()" style="background: rgba(255,255,255,0.1); padding: 8px 15px; border-radius: 8px;">
            <i class="fas fa-shopping-cart"></i> <span id="cart-count">0</span>
        </a>
    </nav>
</header>

<section class="hero">
    <h1>Welcome to <span>Simeon Cafe</span></h1>
    <p>Handcrafted Coffee in Silago</p>
</section>

<div class="main-content">
    <aside class="sidebar">
        <h3 style="font-size: 16px;">Categories</h3>
        <ul style="list-style: none; padding: 0; font-size: 14px;">
            <li><a href="/" style="text-decoration: none; color: var(--accent-gold); font-weight: bold;">ALL ITEMS</a></li>
        </ul>
    </aside>

    <div class="product-grid">
        <% if (products && products.length > 0) { %>
            <% products.forEach(p => { %>
                <div class="product-card">
                    <img src="/images/<%= p.image %>" class="product-img" onerror="this.src='/images/default.jpg'">
                    <h4 style="margin: 10px 0;"><%= p.name %></h4>
                    <div style="font-weight: bold; color: #8D6E63; margin-bottom: 10px;">₱<%= p.price_1 || 0 %></div>
                    <div style="display: flex; gap: 5px;">
                        <input type="number" value="1" min="1" id="qty-<%= p.id %>" style="width: 40px; text-align: center;">
                        <button class="<%= storeOpen ? 'btn-add' : 'btn-disabled' %>" 
                                onclick="addToCart('<%= p.id %>', '<%= p.name %>', <%= p.price_1 || 0 %>)"
                                <%= !storeOpen ? 'disabled' : '' %>>
                            <%= storeOpen ? 'Add' : 'Closed' %>
                        </button>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <p style="grid-column: 1/-1; text-align: center; color: #888;">No products available yet.</p>
        <% } %>
    </div>
</div>

<script>
    let cart = [];

    function addToCart(id, name, price) {
        const qtyInput = document.getElementById('qty-' + id);
        const qty = parseInt(qtyInput.value) || 1;
        
        const existing = cart.find(item => item.id === id);
        if (existing) {
            existing.quantity += qty;
        } else {
            cart.push({ id: id, name: name, price: price, quantity: qty });
        }
        
        updateUI();
        alert(name + " added to cart!");
    }

    function updateUI() {
        const count = cart.reduce((sum, item) => sum + item.quantity, 0);
        document.getElementById('cart-count').innerText = count;
    }

    async function checkout() {
        if (cart.length === 0) return alert("Cart is empty!");
        const customerName = prompt("Enter your name for the order:");
        if (!customerName) return;

        const orderData = {
            customer_name: customerName,
            items: cart.map(i => i.name + " (x" + i.quantity + ")").join(', '),
            total_price: cart.reduce((sum, i) => sum + (i.price * i.quantity), 0)
        };

        try {
            const res = await fetch('/api/place-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(orderData)
            });
            if (res.ok) {
                alert("Order placed! Thank you.");
                cart = [];
                updateUI();
            } else {
                alert("Order failed. Check database.");
            }
        } catch (e) {
            alert("Error: " + e.message);
        }
    }
</script>
</body>
</html>