<!DOCTYPE html>
<html>
<head>
    <title>Simeon Brewers - Order Online</title>
    <style>
        body { background: #F8F4F1; font-family: 'Segoe UI', sans-serif; margin: 0; padding: 20px; padding-bottom: 100px; }
        .header { text-align: center; padding: 40px; background: #2D1B14; color: white; border-radius: 0 0 30px 30px; margin: -20px -20px 40px -20px; }
        .menu-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 20px; max-width: 1200px; margin: 0 auto; }
        .product-card { background: white; border-radius: 20px; overflow: hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05); text-align: center; padding-bottom: 15px; }
        .order-btn { background: #2D1B14; color: #C6A664; border: none; padding: 10px 20px; border-radius: 10px; font-weight: bold; cursor: pointer; }
        
        /* Floating Cart Bar */
        .cart-bar { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); width: 90%; max-width: 600px; background: #2D1B14; color: white; padding: 15px 25px; border-radius: 50px; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 10px 30px rgba(0,0,0,0.3); display: none; }
        .checkout-btn { background: #C6A664; color: #2D1B14; border: none; padding: 10px 20px; border-radius: 25px; font-weight: bold; cursor: pointer; }
        
        /* Modal for Checkout */
        .modal { display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); justify-content: center; align-items: center; }
        .modal-content { background: white; padding: 30px; border-radius: 20px; width: 400px; }
        input { width: 100%; padding: 10px; margin: 10px 0; border: 1px solid #ddd; border-radius: 8px; }
    </style>
</head>
<body>
    <div class="header">
        <h1>SIMEON BREWERS</h1>
        <p style="color: #C6A664;">Premium Coffee Ordering</p>
    </div>

    <div class="menu-grid">
        <% products.forEach(p => { %>
            <div class="product-card">
                <img src="/images/<%= p.image %>" style="width: 100%; height: 200px; object-fit: cover;">
                <h3><%= p.name %></h3>
                <p style="color: #C6A664; font-weight: bold;">₱<%= p.price_1 %></p>
                <button class="order-btn" onclick="addToCart('<%= p.name %>', <%= p.price_1 %>)">Add to Order</button>
            </div>
        <% }); %>
    </div>

    <div id="cartBar" class="cart-bar">
        <div>
            <span id="cartCount">0 Items</span> | <strong>Total: ₱<span id="cartTotal">0</span></strong>
        </div>
        <button class="checkout-btn" onclick="showCheckout()">Checkout Now</button>
    </div>

    <div id="checkoutModal" class="modal">
        <div class="modal-content">
            <h2 style="color: #2D1B14;">Complete Your Order</h2>
            <p id="orderSummary" style="font-size: 14px; color: #666;"></p>
            <form action="/place-order" method="POST">
                <input type="hidden" name="items" id="itemsInput">
                <input type="hidden" name="total" id="totalInput">
                <input type="text" name="customer_name" placeholder="Your Name" required>
                <button type="submit" class="order-btn" style="width: 100%; margin-top: 10px;">Place Order</button>
                <button type="button" onclick="closeCheckout()" style="background: none; border: none; color: #888; width: 100%; margin-top: 10px; cursor: pointer;">Cancel</button>
            </form>
        </div>
    </div>

    <script>
        let cart = [];
        let total = 0;

        function addToCart(name, price) {
            cart.push({ name, price });
            total += price;
            updateCartUI();
        }

        function updateCartUI() {
            document.getElementById('cartBar').style.display = cart.length > 0 ? 'flex' : 'none';
            document.getElementById('cartCount').innerText = cart.length + " Items";
            document.getElementById('cartTotal').innerText = total;
        }

        function showCheckout() {
            const itemsSummary = cart.map(i => i.name).join(", ");
            document.getElementById('orderSummary').innerText = itemsSummary;
            document.getElementById('itemsInput').value = itemsSummary;
            document.getElementById('totalInput').value = total;
            document.getElementById('checkoutModal').style.display = 'flex';
        }

        function closeCheckout() {
            document.getElementById('checkoutModal').style.display = 'none';
        }
    </script>
</body>
</html>