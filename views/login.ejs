<!DOCTYPE html>
<html>
<head>
    <title>Simeon Admin - Login</title>
    <style>
        body { background: #2D1B14; font-family: 'Segoe UI', sans-serif; display: flex; justify-content: center; align-items: center; height: 100vh; margin: 0; }
        .login-card { background: white; padding: 40px; border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,0.5); width: 350px; text-align: center; }
        input { width: 100%; padding: 12px; margin: 10px 0; border: 1px solid #ddd; border-radius: 8px; box-sizing: border-box; }
        button { width: 100%; background: #2D1B14; color: #C6A664; border: none; padding: 12px; border-radius: 8px; font-weight: bold; cursor: pointer; margin-top: 10px; }
        .error { color: #e74c3c; font-size: 14px; margin-bottom: 10px; }
    </style>
</head>
<body>
    <div class="login-card">
        <h2 style="color: #2D1B14; margin-bottom: 5px;">Simeon Brewers</h2>
        <p style="color: #888; font-size: 14px; margin-bottom: 25px;">Admin Portal</p>
        
        <% if (error) { %>
            <div class="error"><%= error %></div>
        <% } %>

        <form action="/login" method="POST">
            <input type="text" name="username" placeholder="Username" required>
            <input type="password" name="password" placeholder="Password" required>
            <button type="submit">Login</button>
        </form>
    </div>
</body>
</html>