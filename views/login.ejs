<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simeon Admin | Login</title>
    <!-- Google Fonts & FontAwesome -->
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        :root {
            --bg-color: #0f0f0f;
            --card-bg: rgba(26, 26, 26, 0.9);
            --accent-gold: #C6A664;
            --accent-hover: #e0c285;
            --text-light: #ffffff;
            --error-red: #ff4d4d;
        }

        body { 
            background: var(--bg-color); 
            background-image: 
                radial-gradient(circle at 20% 30%, rgba(198, 166, 100, 0.05) 0%, transparent 40%),
                radial-gradient(circle at 80% 70%, rgba(198, 166, 100, 0.05) 0%, transparent 40%);
            font-family: 'Poppins', sans-serif; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            height: 100vh; 
            margin: 0; 
            color: var(--text-light);
        }

        /* --- Login Card --- */
        .login-card { 
            background: var(--card-bg); 
            padding: 50px 40px; 
            border-radius: 24px; 
            box-shadow: 0 20px 50px rgba(0,0,0,0.6); 
            width: 100%;
            max-width: 380px; 
            text-align: center; 
            border: 1px solid rgba(198, 166, 100, 0.1);
            backdrop-filter: blur(10px);
        }

        .logo-container {
            margin-bottom: 30px;
        }

        .logo-container i {
            font-size: 3rem;
            color: var(--accent-gold);
            margin-bottom: 10px;
        }

        h2 { 
            font-size: 24px;
            letter-spacing: 2px;
            text-transform: uppercase;
            margin: 0;
            color: var(--text-light);
        }

        .subtitle { 
            color: var(--accent-gold); 
            font-size: 12px; 
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-bottom: 30px;
            font-weight: 300;
        }

        /* --- Form Elements --- */
        .input-group {
            position: relative;
            margin-bottom: 20px;
        }

        .input-group i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #555;
            font-size: 14px;
        }

        input { 
            width: 100%; 
            padding: 14px 14px 14px 45px; 
            background: #252525;
            border: 1px solid #333; 
            border-radius: 12px; 
            box-sizing: border-box; 
            color: white;
            font-family: inherit;
            transition: all 0.3s ease;
        }

        input:focus {
            outline: none;
            border-color: var(--accent-gold);
            background: #2a2a2a;
            box-shadow: 0 0 15px rgba(198, 166, 100, 0.1);
        }

        button { 
            width: 100%; 
            background: var(--accent-gold); 
            color: #000; 
            border: none; 
            padding: 15px; 
            border-radius: 12px; 
            font-weight: 600; 
            font-size: 16px;
            cursor: pointer; 
            margin-top: 10px; 
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        button:hover { 
            background: var(--accent-hover);
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(198, 166, 100, 0.3);
        }

        button:active {
            transform: translateY(0);
        }

        .error { 
            background: rgba(231, 76, 60, 0.1);
            color: var(--error-red); 
            font-size: 13px; 
            padding: 10px;
            border-radius: 8px;
            margin-bottom: 20px; 
            border: 1px solid rgba(231, 76, 60, 0.2);
        }

        .footer-text {
            margin-top: 30px;
            font-size: 11px;
            color: #555;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo-container">
            <i class="fas fa-mug-hot"></i>
            <h2>Simeon Brewers</h2>
            <div class="subtitle">Admin Portal</div>
        </div>
        
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="error">
                <i class="fas fa-exclamation-circle"></i> <%= error %>
            </div>
        <% } %>

        <form action="/login" method="POST">
            <div class="input-group">
                <i class="fas fa-user"></i>
                <input type="text" name="username" placeholder="Username" required>
            </div>

            <div class="input-group">
                <i class="fas fa-lock"></i>
                <input type="password" name="password" placeholder="Password" required>
            </div>

            <button type="submit">Sign In</button>
        </form>

        <div class="footer-text">
            &copy; 2026 Simeon Brewers. All Rights Reserved.
        </div>
    </div>

</body>
</html>