<!DOCTYPE html>
<html>
<head>
    <title>Manage Menu - Simeon Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #F8F4F1, #F5EDE3); min-height: 100vh; display: flex; }
        
        .sidebar { width: 280px; background: linear-gradient(180deg, #2D1B14, #1A0F0A); height: 100vh; color: white; padding: 30px 25px; position: fixed; overflow-y: auto; }
        .logo-section { text-align: center; margin-bottom: 35px; padding-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .logo-img { width: 65px; height: 65px; border-radius: 50%; border: 3px solid #C6A664; margin-bottom: 12px; }
        .logo-title { color: #C6A664; margin: 0 0 15px 0; font-size: 22px; font-weight: 700; }
        .store-status { background: rgba(255,255,255,0.08); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); }
        .status-label { font-size: 12px; margin-bottom: 12px; color: rgba(255,255,255,0.6); font-weight: 500; text-transform: uppercase; }
        .status-btn { border: none; padding: 14px 20px; border-radius: 25px; color: white; font-weight: 600; font-size: 14px; cursor: pointer; width: 100%; }
        .btn-open { background: linear-gradient(135deg, #27ae60, #2ecc71); }
        .btn-closed { background: linear-gradient(135deg, #e74c3c, #c0392b); }
        
        .nav-section { margin-top: 25px; }
        .nav-item { color: rgba(255,255,255,0.75); text-decoration: none; padding: 14px 18px; border-radius: 12px; font-size: 15px; font-weight: 500; display: block; margin-bottom: 8px; }
        .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.12); color: white; transform: translateX(4px); }
        .nav-divider { border: 0; border-top: 1px solid rgba(255,255,255,0.12); margin: 25px 0; }
        .live-site-link { color: #C6A664; border: 2px solid rgba(198,166,100,0.3); background: rgba(198,166,100,0.1); text-align: center; font-weight: 600; margin-top: 10px; }
        .logout-link { color: #ff7675; font-weight: 600; }
        
        .main-content { margin-left: 280px; padding: 50px; width: calc(100% - 280px); }
        .page-header { color: #2D1B14; font-size: 36px; font-weight: 700; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; }
        
        .btn-add { background: linear-gradient(135deg, #C6A664, #D4B085); color: white; padding: 14px 24px; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; text-decoration: none; display: inline-flex; align-items: center; gap: 8px; }
        .btn-add:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(198,166,100,0.3); }
        
        .menu-card { background: rgba(255,255,255,0.95); border-radius: 24px; box-shadow: 0 20px 60px rgba(45,27,20,0.08); overflow: hidden; margin-bottom: 30px; }
        .card-title { background: linear-gradient(135deg, #2D1B14, #3A271C); color: white; padding: 20px 30px; font-size: 18px; font-weight: 700; }
        
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 18px 25px; background: rgba(45,27,20,0.05); color: #2D1B14; font-weight: 700; font-size: 14px; text-transform: uppercase; border-bottom: 2px solid rgba(198,166,100,0.2); }
        td { padding: 18px 25px; border-bottom: 1px solid rgba(232,220,202,0.3); color: #2D1B14; }
        tr:hover td { background: rgba(198,166,100,0.05); }
        
        .product-img { width: 50px; height: 50px; border-radius: 8px; object-fit: cover; background: #f5f5f5; }
        .product-name { font-weight: 600; font-size: 16px; }
        .product-category { font-size: 12px; color: #8D6E63; background: rgba(198,166,100,0.15); padding: 4px 10px; border-radius: 20px; display: inline-block; }
        .product-price { font-weight: 700; color: #C6A664; font-size: 16px; }
        
        .action-buttons { display: flex; gap: 8px; }
        .action-btn { padding: 8px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 600; text-decoration: none; }
        .btn-edit { background: #3498db; color: white; }
        .btn-delete { background: #e74c3c; color: white; }
        .btn-edit:hover { background: #2980b9; }
        .btn-delete:hover { background: #c0392b; }
        
        /* NEW: Availability Toggle Buttons */
        .btn-toggle { padding: 8px 16px; border: none; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 600; min-width: 100px; }
        .btn-available { background: #27ae60; color: white; }
        .btn-unavailable { background: #e74c3c; color: white; }
        .btn-toggle:hover { opacity: 0.9; transform: scale(1.02); }
        
        .empty-state { text-align: center; padding: 60px; color: #8D6E63; }
        .empty-state i { font-size: 54px; display: block; margin-bottom: 20px; opacity: 0.4; color: #C6A664; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo-section">
            <img src="/images/Simeon Cafe.jpg" class="logo-img" alt="Simeon Brewers" onerror="this.src='https://via.placeholder.com/65/2D1B14/C6A664?text=S'">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <div class="status-label">STORE STATUS</div>
                <form action="/admin/toggle-status" method="POST">
                    <button type="submit" class="status-btn <%= storeOpen ? 'btn-open' : 'btn-closed' %>"><%= storeOpen ? 'OPEN' : 'CLOSED' %></button>
                </form>
            </div>
        </div>
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item"><i class="fas fa-list"></i> Active Orders</a>
            <a href="/admin/menu" class="nav-item active"><i class="fas fa-utensils"></i> Manage Menu</a>
            <a href="/admin/categories" class="nav-item"><i class="fas fa-tags"></i> Manage Categories</a>
            <a href="/admin/reports" class="nav-item"><i class="fas fa-chart-bar"></i> Daily Reports</a>
            <hr class="nav-divider">
            <a href="/" target="_blank" class="nav-item live-site-link"><i class="fas fa-external-link-alt"></i> View Live Site</a>
            <hr class="nav-divider">
            <a href="/logout" class="nav-item logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="page-header">
            <span><i class="fas fa-utensils"></i> Manage Menu</span>
            <a href="/admin/add-product" class="btn-add"><i class="fas fa-plus"></i> Add Product</a>
        </h1>
        
        <% if (products && products.length > 0) { %>
        <div class="menu-card">
            <div class="card-title"><i class="fas fa-coffee"></i> All Products</div>
            <table>
                <thead>
                    <tr>
                        <th>Image</th>
                        <th>Name</th>
                        <th>Category</th>
                        <th>Prices</th>
                        <th>Available</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% products.forEach(function(product) { %>
                    <tr>
                        <td>
                            <img src="/images/<%= product.image %>" class="product-img" alt="<%= product.name %>" onerror="this.src='https://via.placeholder.com/50/2D1B14/C6A664?text=?'">
                        </td>
                        <td>
                            <div class="product-name"><%= product.name %></div>
                            <div style="font-size:12px;color:#8D6E63;"><%= product.description || '' %></div>
                        </td>
                        <td><span class="product-category"><%= product.category %></span></td>
                        <td>
                            <div class="product-price">₱<%= product.price_1 %></div>
                            <% if (product.price_2 > 0) { %>
                            <div style="font-size:12px;color:#8D6E63;">Medium: ₱<%= product.price_2 %></div>
                            <% } %>
                            <% if (product.price_3 > 0) { %>
                            <div style="font-size:12px;color:#8D6E63;">Large: ₱<%= product.price_3 %></div>
                            <% } %>
                        </td>
                        <td>
                            <form action="/admin/toggle-product" method="POST">
                                <input type="hidden" name="productId" value="<%= product.id %>">
                                <input type="hidden" name="active" value="<%= product.active == 1 ? 0 : 1 %>">
                                <% if (product.active == 1) { %>
                                <button type="submit" class="btn-toggle btn-available">
                                    <i class="fas fa-check"></i> Available
                                </button>
                                <% } else { %>
                                <button type="submit" class="btn-toggle btn-unavailable">
                                    <i class="fas fa-times"></i> Unavailable
                                </button>
                                <% } %>
                            </form>
                        </td>
                        <td>
                            <div class="action-buttons">
                                <a href="/admin/edit-product/<%= product.id %>" class="action-btn btn-edit"><i class="fas fa-edit"></i> Edit</a>
                                <a href="/admin/delete-product/<%= product.id %>" class="action-btn btn-delete" onclick="return confirm('Are you sure you want to delete this product?');"><i class="fas fa-trash"></i> Delete</a>
                            </div>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
        <% } else { %>
        <div class="menu-card">
            <div class="empty-state">
                <i class="fas fa-coffee"></i>
                <h3>No Products Yet</h3>
                <p>Add your first product to get started.</p>
                <a href="/admin/add-product" class="btn-add" style="margin-top:20px;"><i class="fas fa-plus"></i> Add Product</a>
            </div>
        </div>
        <% } %>
    </div>
</body>
</html>