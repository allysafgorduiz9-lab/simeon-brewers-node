<!DOCTYPE html>
<html>
<head>
    <title>Edit Product</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        body { font-family: 'Segoe UI'; padding: 50px; background: #f5f5f5; }
        .card { background: white; padding: 30px; border-radius: 16px; max-width: 500px; margin: auto; }
        h1 { color: #2D1B14; }
        input, select { width: 100%; padding: 12px; margin: 10px 0; border: 1px solid #ddd; border-radius: 8px; }
        button { background: #C6A664; color: white; padding: 14px 24px; border: none; border-radius: 8px; cursor: pointer; }
        .btn-back { background: #666; margin-right: 10px; }
    </style>
</head>
<body>
    <div class="card">
        <h1>Edit Product</h1>
        <form action="/admin/update-product/<%= product.id %>" method="POST">
            <label>Name</label>
            <input type="text" name="name" value="<%= product.name %>" required>
            
            <label>Category</label>
            <input type="text" name="category" value="<%= product.category %>">
            
            <label>Price 1</label>
            <input type="number" name="price_1" value="<%= product.price_1 %>" step="0.01">
            
            <label>Price 2</label>
            <input type="number" name="price_2" value="<%= product.price_2 %>" step="0.01">
            
            <label>Price 3</label>
            <input type="number" name="price_3" value="<%= product.price_3 %>" step="0.01">
            
            <label>Description</label>
            <input type="text" name="description" value="<%= product.description %>">
            
            <label>
                <input type="checkbox" name="active" <%= product.active ? 'checked' : '' %>> Active
            </label>
            
            <button type="submit">Save</button>
            <a href="/admin/menu"><button type="button" class="btn-back">Back</button></a>
        </form>
    </div>
</body>
</html>