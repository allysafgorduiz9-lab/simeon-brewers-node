<!DOCTYPE html>
<html>
<head>
    <title>Manage Categories - Simeon Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #F8F4F1, #F5EDE3); min-height: 100vh; display: flex; }
        
        .sidebar { width: 280px; background: linear-gradient(180deg, #2D1B14, #1A0F0A); height: 100vh; color: white; padding: 30px 25px; position: fixed; }
        .logo-section { text-align: center; margin-bottom: 35px; }
        .logo-img { width: 65px; height: 65px; border-radius: 50%; border: 3px solid #C6A664; margin-bottom: 12px; }
        .logo-title { color: #C6A664; font-size: 22px; font-weight: 700; }
        .store-status { background: rgba(255,255,255,0.08); padding: 20px; border-radius: 16px; }
        .status-label { font-size: 12px; margin-bottom: 12px; color: rgba(255,255,255,0.6); font-weight: 500; text-transform: uppercase; }
        .status-btn { border: none; padding: 14px 20px; border-radius: 25px; color: white; font-weight: 600; font-size: 14px; cursor: pointer; width: 100%; }
        .btn-open { background: #27ae60; }
        .btn-closed { background: #e74c3c; }
        
        .nav-section { margin-top: 25px; }
        .nav-item { color: rgba(255,255,255,0.75); text-decoration: none; padding: 14px 18px; border-radius: 12px; font-size: 15px; font-weight: 500; display: block; margin-bottom: 8px; }
        .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.12); color: white; }
        .nav-divider { border: 0; border-top: 1px solid rgba(255,255,255,0.12); margin: 25px 0; }
        .live-site-link { color: #C6A664; border: 2px solid rgba(198,166,100,0.3); background: rgba(198,166,100,0.1); text-align: center; font-weight: 600; margin-top: 10px; }
        .logout-link { color: #ff7675; font-weight: 600; }
        
        .main-content { margin-left: 280px; padding: 50px; width: calc(100% - 280px); }
        .page-header { color: #2D1B14; font-size: 36px; font-weight: 700; margin-bottom: 40px; display: flex; justify-content: space-between; align-items: center; }
        
        .btn-add { background: linear-gradient(135deg, #C6A664, #D4B085); color: white; padding: 14px 24px; border: none; border-radius: 12px; font-weight: 600; cursor: pointer; }
        
        .cat-card { background: white; border-radius: 16px; padding: 20px; margin-bottom: 15px; box-shadow: 0 5px 20px rgba(45,27,20,0.08); display: flex; justify-content: space-between; align-items: center; }
        .cat-card h3 { color: #2D1B14; margin-bottom: 5px; }
        .cat-card p { color: #8D6E63; font-size: 14px; }
        
        .action-btn { padding: 8px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 600; background: #e74c3c; color: white; }
        
        .form-card { background: white; border-radius: 24px; padding: 30px; margin-top: 30px; box-shadow: 0 20px 60px rgba(45,27,20,0.08); }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: 600; color: #2D1B14; }
        .form-group input { width: 100%; padding: 12px; border: 2px solid rgba(198,166,100,0.2); border-radius: 8px; }
        
        .empty-state { text-align: center; padding: 60px; color: #8D6E63; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo-section">
            <img src="/images/Simeon Cafe.jpg" class="logo-img" alt="Logo" onerror="this.style.display='none'">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <div class="status-label">STORE STATUS</div>
                <button type="button" class="status-btn" id="storeBtn" onclick="toggleStore()"><%= storeStatus %></button>
            </div>
        </div>
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item"><i class="fas fa-list"></i> Active Orders</a>
            <a href="/admin/menu" class="nav-item"><i class="fas fa-utensils"></i> Manage Menu</a>
            <a href="/admin/categories" class="nav-item active"><i class="fas fa-tags"></i> Manage Categories</a>
            <a href="/admin/reports" class="nav-item"><i class="fas fa-chart-bar"></i> Reports</a>
            <hr class="nav-divider">
            <a href="/" target="_blank" class="nav-item live-site-link"><i class="fas fa-external-link-alt"></i> View Live Site</a>
            <a href="/logout" class="nav-item logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="page-header">
            <span><i class="fas fa-tags"></i> Manage Categories</span>
            <button class="btn-add" onclick="document.getElementById('addForm').style.display='block'">
                <i class="fas fa-plus"></i> Add Category
            </button>
        </h1>
        
        <% if (categories && categories.length > 0) { %>
            <% categories.forEach(function(cat) { %>
            <div class="cat-card">
                <div>
                    <h3><%= cat.name %></h3>
                    <p><%= cat.description || 'No description' %></p>
                </div>
                <form action="/admin/delete-category" method="POST">
                    <input type="hidden" name="categoryId" value="<%= cat.id %>">
                    <button type="submit" class="action-btn" onclick="return confirm('Delete this category?')">Delete</button>
                </form>
            </div>
            <% }); %>
        <% } else { %>
        <div class="empty-state">
            <i class="fas fa-tags" style="font-size:54px;color:#C6A664;opacity:0.4;"></i>
            <h3>No Categories</h3>
            <p>Add your first category.</p>
        </div>
        <% } %>
        
        <div id="addForm" class="form-card" style="display:none;">
            <h3><i class="fas fa-plus"></i> Add Category</h3>
            <form action="/admin/add-category" method="POST">
                <div class="form-group">
                    <label>Category Name *</label>
                    <input type="text" name="name" required>
                </div>
                <div class="form-group">
                    <label>Description</label>
                    <input type="text" name="description">
                </div>
                <button type="submit" class="btn-add">Save Category</button>
                <button type="button" onclick="document.getElementById('addForm').style.display='none'" style="margin-left:10px;padding:14px 24px;background:#8D6E63;color:white;border:none;border-radius:12px;cursor:pointer;">Cancel</button>
            </form>
        </div>
    </div>

    <script>
    var storeStatus = "<%= storeStatus %>";

    async function toggleStore() {
        await fetch('/admin/toggle-status', { method: 'POST' });
        var btn = document.getElementById('storeBtn');
        if (storeStatus == "OPEN") {
            storeStatus = "CLOSED";
            btn.className = "status-btn btn-closed";
        } else {
            storeStatus = "OPEN";
            btn.className = "status-btn btn-open";
        }
    }
    </script>
</body>
</html>