<!DOCTYPE html>
<html>
<head>
    <title>Manage Categories - Simeon Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #F8F4F1, #F5EDE3); min-height: 100vh; display: flex; }
        
        .sidebar { width: 280px; background: linear-gradient(180deg, #2D1B14, #1A0F0A); height: 100vh; color: white; padding: 30px 25px; position: fixed; overflow-y: auto; }
        .logo-section { text-align: center; margin-bottom: 35px; padding-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .logo-img { width: 65px; height: 65px; border-radius: 50%; border: 3px solid #C6A664; margin-bottom: 12px; }
        .logo-title { color: #C6A664; margin: 0 0 15px 0; font-size: 22px; font-weight: 700; }
        .store-status { background: rgba(255,255,255,0.08); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); }
        .status-label { font-size: 12px; margin-bottom: 12px; color: rgba(255,255,255,0.6); font-weight: 500; text-transform: uppercase; }
        .status-btn { border: none; padding: 14px 20px; border-radius: 25px; color: white; font-weight: 600; font-size: 14px; cursor: pointer; width: 100%; }
        .btn-open { background: linear-gradient(135deg, #27ae60, #2ecc71); }
        .btn-closed { background: linear-gradient(135deg, #e74c3c, #c0392b); }
        
        .nav-section { margin-top: 25px; }
        .nav-item { color: rgba(255,255,255,0.75); text-decoration: none; padding: 14px 18px; border-radius: 12px; font-size: 15px; font-weight: 500; display: block; margin-bottom: 8px; }
        .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.12); color: white; transform: translateX(4px); }
        .nav-divider { border: 0; border-top: 1px solid rgba(255,255,255,0.12); margin: 25px 0; }
        .live-site-link { color: #C6A664; border: 2px solid rgba(198,166,100,0.3); background: rgba(198,166,100,0.1); text-align: center; font-weight: 600; margin-top: 10px; }
        .logout-link { color: #ff7675; font-weight: 600; }
        
        .main-content { margin-left: 280px; padding: 50px; width: calc(100% - 280px); }
        .page-header { color: #2D1B14; font-size: 36px; font-weight: 700; margin-bottom: 40px; }
        
        .categories-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-bottom: 40px; }
        
        .category-card { background: rgba(255,255,255,0.95); border-radius: 16px; box-shadow: 0 10px 30px rgba(45,27,20,0.08); padding: 25px; position: relative; }
        .category-card i { font-size: 32px; color: #C6A664; margin-bottom: 15px; }
        .category-card h3 { color: #2D1B14; font-size: 20px; margin-bottom: 5px; }
        .category-card p { color: #8D6E63; font-size: 14px; }
        .category-actions { position: absolute; top: 20px; right: 20px; display: flex; gap: 10px; }
        .action-btn { padding: 8px 12px; border: none; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 600; }
        .btn-delete { background: #e74c3c; color: white; }
        
        .add-card { background: rgba(198,166,100,0.1); border: 2px dashed rgba(198,166,100,0.3); border-radius: 16px; padding: 25px; text-align: center; cursor: pointer; transition: all 0.3s; }
        .add-card:hover { border-color: #C6A664; background: rgba(198,166,100,0.15); }
        .add-card i { font-size: 32px; color: #C6A664; margin-bottom: 15px; }
        .add-card h3 { color: #C6A664; font-size: 20px; }
        
        .form-card { background: rgba(255,255,255,0.95); border-radius: 24px; box-shadow: 0 20px 60px rgba(45,27,20,0.08); overflow: hidden; max-width: 500px; }
        .card-title { background: linear-gradient(135deg, #2D1B14, #3A271C); color: white; padding: 25px 30px; font-size: 20px; font-weight: 700; }
        
        .form-body { padding: 30px; }
        .form-group { margin-bottom: 20px; }
        .form-group label { display: block; margin-bottom: 8px; font-weight: 600; color: #2D1B14; }
        .form-group input { width: 100%; padding: 14px 18px; border: 2px solid rgba(198,166,100,0.2); border-radius: 12px; font-size: 14px; }
        .form-group input:focus { outline: none; border-color: #C6A664; }
        
        .btn-submit { background: linear-gradient(135deg, #C6A664, #D4B085); color: white; padding: 14px 24px; border: none; border-radius: 12px; font-size: 14px; font-weight: 600; cursor: pointer; }
        
        .empty-state { text-align: center; padding: 60px; color: #8D6E63; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo-section">
            <img src="/images/Simeon Cafe.jpg" class="logo-img" alt="Simeon Brewers" onerror="this.src='https://via.placeholder.com/65/2D1B14/C6A664?text=S'">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <div class="status-label">STORE STATUS</div>
                <form action="/admin/toggle-status" method="POST">
                    <button type="submit" class="status-btn <%= storeOpen ? 'btn-open' : 'btn-closed' %>"><%= storeOpen ? 'OPEN' : 'CLOSED' %></button>
                </form>
            </div>
        </div>
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item"><i class="fas fa-list"></i> Active Orders</a>
            <a href="/admin/menu" class="nav-item"><i class="fas fa-utensils"></i> Manage Menu</a>
            <a href="/admin/categories" class="nav-item active"><i class="fas fa-tags"></i> Manage Categories</a>
            <a href="/admin/reports" class="nav-item"><i class="fas fa-chart-bar"></i> Daily Reports</a>
            <hr class="nav-divider">
            <a href="/" target="_blank" class="nav-item live-site-link"><i class="fas fa-external-link-alt"></i> View Live Site</a>
            <hr class="nav-divider">
            <a href="/logout" class="nav-item logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="page-header"><i class="fas fa-tags"></i> Manage Categories</h1>
        
        <% if (categories.length > 0) { %>
        <div class="categories-grid">
            <% categories.forEach(function(category) { %>
            <div class="category-card">
                <i class="fas fa-tag"></i>
                <h3><%= category.name %></h3>
                <p><%= category.description || 'No description' %></p>
                <div class="category-actions">
                    <form action="/admin/delete-category" method="POST" onsubmit="return confirm('Delete this category?');">
                        <input type="hidden" name="categoryId" value="<%= category.id %>">
                        <button type="submit" class="action-btn btn-delete"><i class="fas fa-trash"></i></button>
                    </form>
                </div>
            </div>
            <% }); %>
            
            <div class="add-card" onclick="document.getElementById('addForm').style.display='block'">
                <i class="fas fa-plus"></i>
                <h3>Add Category</h3>
            </div>
        </div>
        <% } else { %>
        <div class="form-card">
            <div class="empty-state">
                <i class="fas fa-tags" style="font-size:54px;color:#C6A664;opacity:0.4;"></i>
                <h3>No Categories Yet</h3>
                <p>Add your first category to organize products.</p>
            </div>
        </div>
        <% } %>
        
        <div id="addForm" class="form-card" style="display:none; margin-top:30px;">
            <div class="card-title"><i class="fas fa-plus"></i> Add New Category</div>
            <div class="form-body">
                <form action="/admin/add-category" method="POST">
                    <div class="form-group">
                        <label>Category Name *</label>
                        <input type="text" name="name" required placeholder="e.g., Coffee">
                    </div>
                    <div class="form-group">
                        <label>Description</label>
                        <input type="text" name="description" placeholder="Optional description">
                    </div>
                    <button type="submit" class="btn-submit"><i class="fas fa-save"></i> Save Category</button>
                    <button type="button" onclick="document.getElementById('addForm').style.display='none'" style="margin-left:10px;padding:14px 24px;background:#8D6E63;color:white;border:none;border-radius:12px;font-size:14px;font-weight:600;cursor:pointer;">Cancel</button>
                </form>
            </div>
        </div>
    </div>
</body>
</html>