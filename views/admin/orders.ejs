<!DOCTYPE html>
<html>
<head>
    <title>Active Orders - Simeon Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #F8F4F1, #F5EDE3); min-height: 100vh; display: flex; }
        
        .sidebar { width: 280px; background: linear-gradient(180deg, #2D1B14, #1A0F0A); height: 100vh; color: white; padding: 30px 25px; position: fixed; overflow-y: auto; }
        .logo-section { text-align: center; margin-bottom: 35px; padding-bottom: 25px; border-bottom: 1px solid rgba(255,255,255,0.08); }
        .logo-img { width: 65px; height: 65px; border-radius: 50%; border: 3px solid #C6A664; margin-bottom: 12px; }
        .logo-title { color: #C6A664; margin: 0 0 15px 0; font-size: 22px; font-weight: 700; }
        .store-status { background: rgba(255,255,255,0.08); padding: 20px; border-radius: 16px; border: 1px solid rgba(255,255,255,0.1); }
        .status-label { font-size: 12px; margin-bottom: 12px; color: rgba(255,255,255,0.6); font-weight: 500; text-transform: uppercase; }
        .status-btn { border: none; padding: 14px 20px; border-radius: 25px; color: white; font-weight: 600; font-size: 14px; cursor: pointer; width: 100%; }
        .btn-open { background: linear-gradient(135deg, #27ae60, #2ecc71); }
        .btn-closed { background: linear-gradient(135deg, #e74c3c, #c0392b); }
        
        .nav-section { margin-top: 25px; }
        .nav-item { color: rgba(255,255,255,0.75); text-decoration: none; padding: 14px 18px; border-radius: 12px; font-size: 15px; font-weight: 500; display: block; margin-bottom: 8px; }
        .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.12); color: white; transform: translateX(4px); }
        .nav-divider { border: 0; border-top: 1px solid rgba(255,255,255,0.12); margin: 25px 0; }
        .live-site-link { color: #C6A664; border: 2px solid rgba(198,166,100,0.3); background: rgba(198,166,100,0.1); text-align: center; font-weight: 600; margin-top: 10px; }
        .logout-link { color: #ff7675; font-weight: 600; }
        
        .main-content { margin-left: 280px; padding: 50px; width: calc(100% - 280px); }
        .page-header { color: #2D1B14; font-size: 36px; font-weight: 700; margin-bottom: 40px; }
        
        .orders-card { background: rgba(255,255,255,0.95); border-radius: 24px; box-shadow: 0 20px 60px rgba(45,27,20,0.08); overflow: hidden; }
        .card-title { background: linear-gradient(135deg, #2D1B14, #3A271C); color: white; padding: 25px 30px; font-size: 20px; font-weight: 700; }
        
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 20px 25px; background: rgba(45,27,20,0.05); color: #2D1B14; font-weight: 700; font-size: 14px; text-transform: uppercase; border-bottom: 2px solid rgba(198,166,100,0.2); }
        td { padding: 18px 25px; border-bottom: 1px solid rgba(232,220,202,0.3); color: #2D1B14; }
        tr:hover td { background: rgba(198,166,100,0.05); }
        
        .status-badge { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; }
        .badge-completed { background: rgba(39,174,96,0.15); color: #27ae60; }
        .badge-cancelled { background: rgba(231,76,60,0.15); color: #e74c3c; }
        .badge-pending { background: rgba(241,196,15,0.15); color: #f39c12; }
        
        .action-form { display: inline; }
        .action-btn { padding: 8px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 600; }
        .btn-complete { background: #27ae60; color: white; }
        .btn-cancel { background: #e74c3c; color: white; }
        
        .empty-state { text-align: center; padding: 60px; color: #8D6E63; }
        .empty-state i { font-size: 54px; display: block; margin-bottom: 20px; opacity: 0.4; color: #C6A664; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo-section">
            <img src="C:\Users\user\OneDrive\Desktop\simeon-brewers-node\public\images\Simeon Cafe.jpg" class="logo-img" alt="Simeon Brewers" onerror="this.src='https://via.placeholder.com/65/2D1B14/C6A664?text=S'">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <div class="status-label">STORE STATUS</div>
                <form action="/admin/toggle-status" method="POST">
                    <button type="submit" class="status-btn <%= storeOpen ? 'btn-open' : 'btn-closed' %>"><%= storeOpen ? 'OPEN' : 'CLOSED' %></button>
                </form>
            </div>
        </div>
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item active"><i class="fas fa-list"></i> Active Orders</a>
            <a href="/admin/menu" class="nav-item"><i class="fas fa-utensils"></i> Manage Menu</a>
            <a href="/admin/categories" class="nav-item"><i class="fas fa-tags"></i> Manage Categories</a>
            <a href="/admin/reports" class="nav-item"><i class="fas fa-chart-bar"></i> Daily Reports</a>
            <hr class="nav-divider">
            <a href="/" target="_blank" class="nav-item live-site-link"><i class="fas fa-external-link-alt"></i> View Live Site</a>
            <hr class="nav-divider">
            <a href="/logout" class="nav-item logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="page-header"><i class="fas fa-list"></i> Active Orders</h1>
        
        <div class="orders-card">
            <div class="card-title"><i class="fas fa-clipboard-list"></i> All Orders</div>
            
            <% if (orders.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Time</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(function(order) { %>
                    <tr>
                        <td style="font-weight:700;">#<%= order.order_number %></td>
                        <td>
                            <div style="font-weight:600;"><%= order.customer_name %></div>
                            <div style="font-size:12px;color:#8D6E63;"><%= order.contact_number %></div>
                        </td>
                        <td>
                            <% if (order.items && order.items.length > 0) { %>
                                <% order.items.slice(0,2).forEach(function(item) { %>
                                    <div><%= item.name %> (x<%= item.quantity %>)</div>
                                <% }); %>
                                <% if (order.items.length > 2) { %>
                                    <div style="font-size:12px;color:#8D6E63;">+<%= order.items.length - 2 %> more</div>
                                <% } %>
                            <% } else { %>
                                <%= order.items_summary || 'N/A' %>
                            <% } %>
                        </td>
                        <td style="font-weight:700;font-size:18px;">₱<%= order.total_price %></td>
                        <td>
                            <% var statusClass = order.status === 'completed' ? 'completed' : (order.status === 'cancelled' ? 'cancelled' : 'pending'); %>
                            <span class="status-badge badge-<%= statusClass %>"><%= order.status %></span>
                        </td>
                        <td style="color:#8D6E63;"><%= order.time %></td>
                        <td>
                            <% if (order.status === 'pending' || order.status === 'Pending') { %>
                            <form action="/admin/orders/update-status" method="POST" class="action-form">
                                <input type="hidden" name="orderId" value="<%= order.id %>">
                                <input type="hidden" name="status" value="completed">
                                <button type="submit" class="action-btn btn-complete">Complete</button>
                            </form>
                            <form action="/admin/orders/update-status" method="POST" class="action-form">
                                <input type="hidden" name="orderId" value="<%= order.id %>">
                                <input type="hidden" name="status" value="cancelled">
                                <button type="submit" class="action-btn btn-cancel">Cancel</button>
                            </form>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state">
                <i class="fas fa-clipboard-list"></i>
                <h3>No Orders Yet</h3>
                <p>Orders will appear here when customers place them.</p>
            </div>
            <% } %>
        </div>
    </div>
</body>
</html>