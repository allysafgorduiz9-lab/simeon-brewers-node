<!DOCTYPE html>
<html>
<head>
    <title>Active Orders - Simeon Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #F8F4F1, #F5EDE3); min-height: 100vh; display: flex; }
        
        .sidebar { width: 280px; background: linear-gradient(180deg, #2D1B14, #1A0F0A); height: 100vh; color: white; padding: 30px 25px; position: fixed; }
        .logo-section { text-align: center; margin-bottom: 35px; }
        .logo-img { width: 65px; height: 65px; border-radius: 50%; border: 3px solid #C6A664; margin-bottom: 12px; }
        .logo-title { color: #C6A664; font-size: 22px; font-weight: 700; }
        .store-status { background: rgba(255,255,255,0.08); padding: 20px; border-radius: 16px; }
        .status-label { font-size: 12px; margin-bottom: 12px; color: rgba(255,255,255,0.6); font-weight: 500; text-transform: uppercase; }
        .status-btn { border: none; padding: 14px 20px; border-radius: 25px; color: white; font-weight: 600; font-size: 14px; cursor: pointer; width: 100%; }
        .btn-open { background: #27ae60; }
        .btn-closed { background: #e74c3c; }
        
        .nav-section { margin-top: 25px; }
        .nav-item { color: rgba(255,255,255,0.75); text-decoration: none; padding: 14px 18px; border-radius: 12px; font-size: 15px; font-weight: 500; display: block; margin-bottom: 8px; }
        .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.12); color: white; }
        .nav-divider { border: 0; border-top: 1px solid rgba(255,255,255,0.12); margin: 25px 0; }
        .live-site-link { color: #C6A664; border: 2px solid rgba(198,166,100,0.3); background: rgba(198,166,100,0.1); text-align: center; font-weight: 600; margin-top: 10px; }
        .logout-link { color: #ff7675; font-weight: 600; }
        
        .main-content { margin-left: 280px; padding: 50px; width: calc(100% - 280px); }
        .page-header { color: #2D1B14; font-size: 36px; font-weight: 700; margin-bottom: 40px; }
        
        .orders-card { background: white; border-radius: 24px; box-shadow: 0 20px 60px rgba(45,27,20,0.08); overflow: hidden; }
        .card-title { background: linear-gradient(135deg, #2D1B14, #3A271C); color: white; padding: 25px 30px; font-size: 20px; font-weight: 700; }
        
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 20px 25px; background: rgba(45,27,20,0.05); color: #2D1B14; font-weight: 700; font-size: 14px; text-transform: uppercase; }
        td { padding: 18px 25px; border-bottom: 1px solid rgba(232,220,202,0.3); color: #2D1B14; vertical-align: top; }
        
        .status-badge { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; }
        .badge-pending { background: rgba(241,196,15,0.15); color: #f39c12; }
        .badge-preparing { background: rgba(52,152,219,0.15); color: #3498db; }
        .badge-completed { background: rgba(39,174,96,0.15); color: #27ae60; }
        
        .action-form { display: inline; margin-right: 5px; }
        .action-btn { padding: 8px 14px; border: none; border-radius: 8px; cursor: pointer; font-size: 12px; font-weight: 600; }
        .btn-preparing { background: #3498db; color: white; }
        .btn-complete { background: #27ae60; color: white; }
        
        .order-meta { font-size: 11px; color: #8D6E63; margin-top: 4px; }
        .item-list { font-size: 13px; line-height: 1.6; }
        .notes-tag { background: rgba(198,166,100,0.15); color: #C6A664; padding: 4px 10px; border-radius: 6px; font-size: 11px; font-weight: 600; display: inline-block; margin-top: 5px; }
        
        .empty-state { text-align: center; padding: 60px; color: #8D6E63; }
        
        .count-badge { background: #C6A664; color: white; padding: 2px 8px; border-radius: 10px; font-size: 12px; margin-left: 10px; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo-section">
            <img src="/images/Simeon Cafe.jpg" class="logo-img" alt="Logo" onerror="this.style.display='none'">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <div class="status-label">STORE STATUS</div>
                <button type="button" class="status-btn" id="storeBtn" onclick="toggleStore()"><%= storeStatus %></button>
            </div>
        </div>
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item active"><i class="fas fa-list"></i> Active Orders <span class="count-badge"><%= orders.filter(o => o.status !== 'Completed').length %></span></a>
            <a href="/admin/menu" class="nav-item"><i class="fas fa-utensils"></i> Manage Menu</a>
            <a href="/admin/categories" class="nav-item"><i class="fas fa-tags"></i> Manage Categories</a>
            <a href="/admin/reports" class="nav-item"><i class="fas fa-chart-bar"></i> Reports</a>
            <hr class="nav-divider">
            <a href="/" target="_blank" class="nav-item live-site-link"><i class="fas fa-external-link-alt"></i> View Live Site</a>
            <a href="/logout" class="nav-item logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="page-header"><i class="fas fa-list"></i> Active Orders <span class="count-badge"><%= orders.filter(o => o.status !== 'Completed').length %></span></h1>
        
        <div class="orders-card">
            <div class="card-title"><i class="fas fa-clipboard-list"></i> All Orders</div>
            
            <% if (orders && orders.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer Details</th>
                        <th>Order Info</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(function(order) { %>
                    <tr>
                        <td>
                            <div style="font-weight:700; color: #2D1B14;">#<%= order.order_number %></div>
                            <% var phTime = new Date(order.created_at); phTime.setHours(phTime.getHours() + 8); %>
<div class="order-meta">
    <%= phTime.toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'}) %>
    <%= phTime.toLocaleTimeString('en-PH', {hour:'numeric', minute:'2-digit'}) %>
</div>
                        </td>
                        <td>
                            <div style="font-weight:600;"><%= order.customer_name %></div>
                            <div class="order-meta"><i class="fas fa-phone"></i> <%= order.customer_phone || 'N/A' %></div>
                        </td>
                        <td>
                            <div style="font-size:13px;"><i class="fas fa-shopping-bag"></i> <strong><%= order.order_type %></strong></div>
                            <div style="font-size:12px; color:#8D6E63;"><i class="fas fa-credit-card"></i> <%= order.payment_method %></div>
                            <% if (order.special_instructions) { %>
                            <div class="notes-tag"><i class="fas fa-sticky-note"></i> <%= order.special_instructions %></div>
                            <% } %>
                        </td>
                       <td>
    <div class="item-list">
        <% 
        // Debug - show raw items
        var itemsData = '';
        try { itemsData = JSON.stringify(order.items); } catch(e) { itemsData = 'error'; }
        %>
        <!-- <%= itemsData %> -->
        
        <% if (order.items && order.items.length > 0) { %>
            <% order.items.forEach(function(item) { %>
                <div>
                    <%= item.name || 'Unknown' %> 
                    x<%= item.quantity || 1 %> 
                    — ₱<%= ((item.price || 0) * (item.quantity || 1)).toFixed(2) %>
                </div>
            <% }); %>
        <% } else { %>
            <span style="color: #999;">No items</span>
        <% } %>
    </div>
</td>
                        <td style="font-weight:700; font-size: 16px;">₱<%= parseFloat(order.total_amount).toFixed(2) %></td>
                        <td>
                            <span class="status-badge badge-<%= order.status.toLowerCase() %>"><%= order.status %></span>
                        </td>
                        <td>
                            <% if (order.status === 'Pending') { %>
                            <form action="/admin/orders/update-status" method="POST" class="action-form">
                                <input type="hidden" name="orderId" value="<%= order.id %>">
                                <input type="hidden" name="status" value="Preparing">
                                <button type="submit" class="action-btn btn-preparing"><i class="fas fa-fire"></i> Prepare</button>
                            </form>
                            <% } else if (order.status === 'Preparing') { %>
                            <form action="/admin/orders/update-status" method="POST" class="action-form">
                                <input type="hidden" name="orderId" value="<%= order.id %>">
                                <input type="hidden" name="status" value="Completed">
                                <button type="submit" class="action-btn btn-complete"><i class="fas fa-check"></i> Complete</button>
                            </form>
                            <% } else { %>
                            <span style="color:#8D6E63; font-size:12px;"><i class="fas fa-check-double"></i> Done</span>
                            <% } %>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state">
                <i class="fas fa-clipboard-list" style="font-size:54px;color:#C6A664;opacity:0.4;"></i>
                <h3>No Orders Yet</h3>
                <p>Orders will appear here when customers place them.</p>
            </div>
            <% } %>
        </div>
    </div>

    <script>
    var storeStatus = "<%= storeStatus %>";

    async function toggleStore() {
        await fetch('/admin/toggle-status', { method: 'POST' });
        var btn = document.getElementById('storeBtn');
        if (storeStatus == "OPEN") {
            storeStatus = "CLOSED";
            btn.className = "status-btn btn-closed";
        } else {
            storeStatus = "OPEN";
            btn.className = "status-btn btn-open";
        }
    }
    </script>
</body>
</html>