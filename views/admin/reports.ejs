<!DOCTYPE html>
<html>
<head>
    <title>Daily Reports - Simeon Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #F8F4F1, #F5EDE3); min-height: 100vh; display: flex; }
        
        .sidebar { width: 280px; background: linear-gradient(180deg, #2D1B14, #1A0F0A); height: 100vh; color: white; padding: 30px 25px; position: fixed; }
        .logo-section { text-align: center; margin-bottom: 35px; }
        .logo-img { width: 65px; height: 65px; border-radius: 50%; border: 3px solid #C6A664; margin-bottom: 12px; }
        .logo-title { color: #C6A664; font-size: 22px; font-weight: 700; }
        .store-status { background: rgba(255,255,255,0.08); padding: 20px; border-radius: 16px; }
        .status-label { font-size: 12px; margin-bottom: 12px; color: rgba(255,255,255,0.6); font-weight: 500; }
        .status-btn { border: none; padding: 14px 20px; border-radius: 25px; color: white; font-weight: 600; width: 100%; }
        .btn-open { background: #27ae60; }
        .btn-closed { background: #e74c3c; }
        
        .nav-section { margin-top: 25px; }
        .nav-item { color: rgba(255,255,255,0.75); text-decoration: none; padding: 14px 18px; border-radius: 12px; display: block; margin-bottom: 8px; }
        .nav-item.active { background: rgba(255,255,255,0.12); }
        .nav-divider { border: none; border-top: 1px solid rgba(255,255,255,0.2); margin: 25px 0; }
        .live-site-link { color: #C6A664; border: 2px solid rgba(198,166,100,0.3); background: rgba(198,166,100,0.1); text-align: center; margin-top: 10px; }
        .logout-link { color: #ff7675; font-weight: 600; }
        
        .main-content { margin-left: 280px; padding: 50px; width: calc(100% - 280px); }
        .page-header { color: #2D1B14; font-size: 36px; font-weight: 700; margin-bottom: 40px; }
        
        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; margin-bottom: 40px; }
        .stat-card { background: white; border-radius: 24px; padding: 35px; text-align: center; box-shadow: 0 20px 60px rgba(45,27,20,0.08); border-top: 5px solid #C6A664; }
        .stat-number { font-size: 42px; font-weight: 800; color: #2D1B14; }
        .revenue-value { color: #C6A664; }
        .stat-label { color: #8D6E63; text-transform: uppercase; font-size: 12px; font-weight: 700; }
        
        .sales-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 40px; }
        .sales-card { background: white; border-radius: 16px; padding: 20px; text-align: center; box-shadow: 0 10px 30px rgba(0,0,0,0.08); }
        .sales-date { color: #8D6E63; font-size: 14px; font-weight: 600; margin-bottom: 10px; }
        .sales-amount { color: #C6A664; font-size: 28px; font-weight: 800; }
        
        .products-section { background: white; border-radius: 24px; padding: 25px; box-shadow: 0 20px 60px rgba(45,27,20,0.08); margin-bottom: 40px; }
        .section-title { color: #2D1B14; font-size: 18px; font-weight: 700; margin-bottom: 20px; }
        .product-row { display: flex; justify-content: space-between; align-items: center; padding: 15px; background: #f9f9f9; border-radius: 10px; margin-bottom: 10px; }
        .product-rank { color: #C6A664; font-weight: 800; font-size: 18px; width: 30px; }
        .product-name { flex: 1; font-weight: 600; }
        .product-qty { color: #C6A664; font-weight: 700; font-size: 18px; }
        
        .orders-card { background: white; border-radius: 24px; box-shadow: 0 20px 60px rgba(45,27,20,0.08); overflow: hidden; }
        .card-title { background: #2D1B14; color: white; padding: 25px 30px; font-size: 20px; font-weight: 700; }
        
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 20px 25px; background: #f5f5f5; color: #2D1B14; font-weight: 700; }
        td { padding: 18px 25px; border-bottom: 1px solid #eee; color: #2D1B14; }
        
        .status-badge { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; }
        .badge-completed { background: #d4edda; color: #28a745; }
        .item-list { font-size: 13px; line-height: 1.6; }
        .empty-state { text-align: center; padding: 60px; color: #8D6E63; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo-section">
            <img src="/images/Simeon Cafe.jpg" class="logo-img" alt="Logo">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <div class="status-label">STORE STATUS</div>
                <button type="button" class="status-btn" id="storeBtn"><%= storeStatus %></button>
            </div>
        </div>
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item">Active Orders</a>
            <a href="/admin/menu" class="nav-item">Manage Menu</a>
            <a href="/admin/categories" class="nav-item">Manage Categories</a>
            <a href="/admin/reports" class="nav-item active">Reports</a>
            <hr class="nav-divider">
            <a href="/" target="_blank" class="nav-item live-site-link">View Live Site</a>
            <a href="/logout" class="nav-item logout-link">Logout</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="page-header">Daily Reports</h1>
        
        <!-- Main Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-number revenue-value">P<%= totalRevenue %></div>
                <div class="stat-label">Total Revenue</div>
            </div>
            <div class="stat-card">
                <div class="stat-number"><%= totalOrders %></div>
                <div class="stat-label">Orders Completed</div>
            </div>
        </div>
        
        <!-- Sales by Day (Simple Cards) -->
        <div class="sales-grid">
            <% salesByDay.forEach(function(s) { %>
            <div class="sales-card">
                <div class="sales-date"><%= s.date %></div>
                <div class="sales-amount">P<%= s.total.toFixed(2) %></div>
            </div>
            <% }); %>
        </div>
        
        <!-- Top Products (Simple List) -->
        <div class="products-section">
            <div class="section-title">Top Products</div>
            <% var rank = 1; %>
            <% topProducts.forEach(function(p) { %>
            <div class="product-row">
                <span class="product-rank">#<%= rank %></span>
                <span class="product-name"><%= p.name %></span>
                <span class="product-qty"><%= p.quantity %></span>
            </div>
            <% rank++; %>
            <% }); %>
        </div>
        
        <!-- Orders Table -->
        <div class="orders-card">
            <div class="card-title">All Orders</div>
            
            <% if (orders && orders.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(function(order) { %>
                    <tr>
                        <td style="font-weight:700;">#<%= order.order_number %></td>
                        <td><%= order.customer_name %></td>
                        <td>
                            <div class="item-list">
                            <% if (order.items && order.items.length > 0) { %>
                                <% order.items.forEach(function(item) { %>
                                <div><%= item.name %> x<%= item.quantity %></div>
                                <% }); %>
                            <% } else { %>
                                -
                            <% } %>
                            </div>
                        </td>
                        <td style="font-weight:700;">P<%= parseFloat(order.total_amount).toFixed(2) %></td>
                        <td><span class="status-badge badge-completed"><%= order.status %></span></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state"><h3>No Orders</h3></div>
            <% } %>
        </div>
    </div>

    <script>
    var btn = document.getElementById('storeBtn');
    btn.className = "<%= storeStatus %>" === "OPEN" ? "status-btn btn-open" : "status-btn btn-closed";
    </script>
</body>
</html>