<!DOCTYPE html>
<html>
<head>
    <title>Daily Reports - Simeon Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Segoe UI', sans-serif; background: linear-gradient(135deg, #F8F4F1, #F5EDE3); min-height: 100vh; display: flex; }
        
        .sidebar { width: 280px; background: linear-gradient(180deg, #2D1B14, #1A0F0A); height: 100vh; color: white; padding: 30px 25px; position: fixed; }
        .logo-section { text-align: center; margin-bottom: 35px; }
        .logo-img { width: 65px; height: 65px; border-radius: 50%; border: 3px solid #C6A664; margin-bottom: 12px; }
        .logo-title { color: #C6A664; font-size: 22px; font-weight: 700; }
        .store-status { background: rgba(255,255,255,0.08); padding: 20px; border-radius: 16px; }
        .status-btn { border: none; padding: 14px 20px; border-radius: 25px; color: white; font-weight: 600; width: 100%; cursor: pointer; }
        .btn-open { background: #27ae60; }
        .btn-closed { background: #e74c3c; }
        
        .nav-section { margin-top: 25px; }
        .nav-item { color: rgba(255,255,255,0.75); text-decoration: none; padding: 14px 18px; border-radius: 12px; font-size: 15px; display: block; margin-bottom: 8px; }
        .nav-item:hover, .nav-item.active { background: rgba(255,255,255,0.12); color: white; }
        .nav-divider { border: 0; border-top: 1px solid rgba(255,255,255,0.12); margin: 25px 0; }
        .live-site-link { color: #C6A664; border: 2px solid rgba(198,166,100,0.3); background: rgba(198,166,100,0.1); text-align: center; font-weight: 600; margin-top: 10px; }
        .logout-link { color: #ff7675; font-weight: 600; }
        
        .main-content { margin-left: 280px; padding: 50px; width: calc(100% - 280px); }
        .page-header { color: #2D1B14; font-size: 36px; font-weight: 700; margin-bottom: 40px; }
        
        .stats-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; margin-bottom: 40px; }
        .stat-card { background: white; border-radius: 24px; padding: 35px; text-align: center; box-shadow: 0 20px 60px rgba(45,27,20,0.08); border-top: 5px solid #C6A664; }
        .stat-icon { font-size: 42px; color: #C6A664; margin-bottom: 18px; }
        .stat-label { color: #8D6E63; text-transform: uppercase; font-size: 12px; letter-spacing: 1.2px; font-weight: 700; margin-bottom: 12px; }
        .stat-number { font-size: 42px; font-weight: 800; color: #2D1B14; }
        .revenue-value { color: #C6A664; }
        
        .orders-table { background: white; border-radius: 24px; box-shadow: 0 20px 60px rgba(45,27,20,0.08); overflow: hidden; }
        .table-title { background: linear-gradient(135deg, #2D1B14, #3A271C); color: white; padding: 25px 30px; font-size: 20px; font-weight: 700; display: flex; align-items: center; }
        
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 20px 25px; background: rgba(45,27,20,0.05); color: #2D1B14; font-weight: 700; text-transform: uppercase; font-size: 14px; }
        td { padding: 18px 25px; border-bottom: 1px solid rgba(232,220,202,0.3); color: #2D1B14; }
        
        .status-badge { padding: 6px 14px; border-radius: 20px; font-size: 12px; font-weight: 700; text-transform: uppercase; }
        .badge-completed { background: rgba(39,174,96,0.15); color: #27ae60; }
        .badge-cancelled { background: rgba(231,76,60,0.15); color: #e74c3c; }
        .badge-pending { background: rgba(241,196,15,0.15); color: #f39c12; }
        
        .empty-state { text-align: center; padding: 60px; color: #8D6E63; }
    </style>
</head>
<body>
    <div class="sidebar">
        <div class="logo-section">
            <img src="/images/Simeon Cafe.jpg" class="logo-img" alt="Logo" onerror="this.style.display='none'">
            <h3 class="logo-title">SIMEON BREWERS</h3>
            <div class="store-status">
                <button type="button" class="status-btn" id="storeBtn" onclick="toggleStore()"><%= storeStatus %></button>
            </div>
        </div>
        <div class="nav-section">
            <a href="/admin/orders" class="nav-item"><i class="fas fa-list"></i> Active Orders</a>
            <a href="/admin/menu" class="nav-item"><i class="fas fa-utensils"></i> Manage Menu</a>
            <a href="/admin/categories" class="nav-item"><i class="fas fa-tags"></i> Manage Categories</a>
            <a href="/admin/reports" class="nav-item active"><i class="fas fa-chart-bar"></i> Daily Reports</a>
            <hr class="nav-divider">
            <a href="/" target="_blank" class="nav-item live-site-link"><i class="fas fa-external-link-alt"></i> View Live Site</a>
            <a href="/logout" class="nav-item logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
        </div>
    </div>

    <div class="main-content">
        <h1 class="page-header"><i class="fas fa-chart-line"></i> Daily Reports</h1>
        
        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-coins"></i></div>
                <div class="stat-label">Total Revenue</div>
                <div class="stat-number revenue-value">₱<%= totalRevenue %></div>
            </div>
            <div class="stat-card">
                <div class="stat-icon"><i class="fas fa-receipt"></i></div>
                <div class="stat-label">Orders Completed</div>
                <div class="stat-number"><%= totalOrders %></div>
            </div>
        </div>
        
        <!-- Orders Table -->
        <div class="orders-table">
            <div class="table-title">
                <i class="fas fa-list-alt"></i> Today's Orders
            </div>
            
            <% if (orders && orders.length > 0) { %>
            <table>
                <thead>
                    <tr>
                        <th>Order #</th>
                        <th>Customer</th>
                        <th>Items</th>
                        <th>Total</th>
                        <th>Status</th>
                        <th>Date & Time (PHT)</th>
                    </tr>
                </thead>
                <tbody>
                    <% orders.forEach(function(order) { %>
                    <%
                    // Convert to Philippine Time (PHT - UTC+8)
                    var orderDate = order.created_at;
                    var displayTime = '-';
                    if (orderDate) {
                        var dateObj;
                        if (typeof orderDate === 'string') {
                            // Parse MySQL datetime string
                            var parts = orderDate.split(/[- :]/);
                            dateObj = new Date(parts[0], parts[1]-1, parts[2], parts[3], parts[4], parts[5]);
                        } else {
                            dateObj = new Date(orderDate);
                        }
                        if (!isNaN(dateObj.getTime())) {
                            // Convert to Philippine Time (UTC+8)
                            var phtDate = new Date(dateObj.getTime() + (8 * 60 * 60 * 1000));
                            displayTime = phtDate.toLocaleString('en-PH', { 
                                month: 'short', 
                                day: 'numeric', 
                                year: 'numeric',
                                hour: 'numeric', 
                                minute: '2-digit',
                                hour12: true,
                                timeZone: 'Asia/Manila'
                            });
                        }
                    }
                    %>
                    <tr>
                        <td style="font-weight:700;"><%= order.order_number %></td>
                        <td>
                            <div style="font-weight:600;"><%= order.customer_name %></div>
                            <div style="font-size:12px;color:#8D6E63;"><%= order.customer_phone || '-' %></div>
                        </td>
                        <td>
                            <% if (order.items && order.items.length > 0) { %>
                                <% 
                                var itemCount = order.items.length;
                                var preview = '';
                                if (itemCount <= 2) {
                                    preview = order.items.map(function(i) { return i.name + ' x' + i.quantity; }).join(', ');
                                } else {
                                    preview = order.items.slice(0,2).map(function(i) { return i.name + ' x' + i.quantity; }).join(', ') + ' +' + (itemCount - 2) + ' more';
                                }
                                %>
                                <%= preview %>
                            <% } else { %>
                                -
                            <% } %>
                        </td>
                        <td style="font-weight:700;">₱<%= parseFloat(order.total_amount).toFixed(2) %></td>
                        <td>
                            <span class="status-badge badge-<%= (order.status || 'pending').toLowerCase() %>">
                                <%= order.status || 'Pending' %>
                            </span>
                        </td>
                        <td style="color:#8D6E63; font-size:13px;"><%= displayTime %></td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
            <% } else { %>
            <div class="empty-state">
                <i class="fas fa-clipboard-list" style="font-size:54px;opacity:0.4;color:#C6A664;"></i>
                <h3>No Orders Today</h3>
                <p>Orders will appear here once customers place them.</p>
            </div>
            <% } %>
        </div>
    </div>

    <script>
    var storeStatus = "<%= storeStatus %>";

    async function toggleStore() {
        await fetch('/admin/toggle-status', { method: 'POST' });
        var btn = document.getElementById('storeBtn');
        if (storeStatus == "OPEN") {
            storeStatus = "CLOSED";
            btn.className = "status-btn btn-closed";
        } else {
            storeStatus = "OPEN";
            btn.className = "status-btn btn-open";
        }
    }
    </script>
</body>
</html>